---
import FiveStars from "../components/utilities/FiveStars.astro";
---

<section class="py-24 bg-[#DFE0DE]">
    <section class="px-12 md:px-0 container mx-auto">
        <div class="flex justify-center mb-6">
            <span class="bg-[#252525] px-3 py-2 rounded-full text-xs text-white">
                Reviews
            </span>
        </div>
        <div class="mb-12" x-data="{ current: 0, total: 5 }">
            <!-- Reviews Container with Arrows -->
            <div class="relative">
                <!-- Reviews -->
                <div class="space-y-6">
                    <div class="space-y-6 text-center" x-show="current === 0">
                        <FiveStars />
                        <main>
                            <span class="font-semibold text-xl">
                                Keeps getting better! The app keeps improving
                                security and encryption — and also adding
                                features.
                            </span>
                        </main>
                        <footer>
                            <div>
                                <span class="w-12 h-12 bg-orange-600 text-white p-2 rounded-full mb-3 mx-auto flex items-center justify-center">
                                    FM
                                </span>
                            </div>
                            <div>
                                <span class="font-semibold">
                                    Frederic Maddock
                                </span>
                            </div>
                            <div class="text-sm">Google Review</div>
                        </footer>
                    </div>

                    <div class="space-y-6 text-center" x-show="current === 1">
                        <FiveStars />
                        <main>
                            <span class="font-semibold text-xl">
                                Keeps getting better! The app keeps improving
                                security and encryption — and also adding
                                features.
                            </span>
                        </main>
                        <footer>
                            <div>
                                <span class="w-12 h-12 bg-orange-600 text-white p-2 rounded-full mb-3 mx-auto flex items-center justify-center">
                                    JM
                                </span>
                            </div>
                            <div>
                                <span class="font-semibold">James Madison</span>
                            </div>
                            <div class="text-sm">Google Review</div>
                        </footer>
                    </div>

                    <div class="space-y-6 text-center" x-show="current === 2">
                        <FiveStars />
                        <main>
                            <span class="font-semibold text-xl">
                                Keeps getting better! The app keeps improving
                                security and encryption — and also adding
                                features.
                            </span>
                        </main>
                        <footer>
                            <div>
                                <span class="w-12 h-12 bg-orange-600 text-white p-2 rounded-full mb-3 mx-auto flex items-center justify-center">
                                    TH
                                </span>
                            </div>
                            <div>
                                <span class="font-semibold">Tom Hawell</span>
                            </div>
                            <div class="text-sm">Instagram</div>
                        </footer>
                    </div>

                    <div class="space-y-6 text-center" x-show="current === 3">
                        <FiveStars />
                        <main>
                            <span class="font-semibold text-xl">
                                Keeps getting better! The app keeps improving
                                security and encryption — and also adding
                                features.
                            </span>
                        </main>
                        <footer>
                            <div>
                                <span class="w-12 h-12 bg-orange-600 text-white p-2 rounded-full mb-3 mx-auto flex items-center justify-center">
                                    MFA
                                </span>
                            </div>
                            <div>
                                <span class="font-semibold">
                                    Mark Forbes Adoko
                                </span>
                            </div>
                            <div class="text-sm">Google Review</div>
                        </footer>
                    </div>

                    <div class="space-y-6 text-center" x-show="current === 4">
                        <FiveStars />
                        <main>
                            <span class="font-semibold text-xl">
                                Keeps getting better! The app keeps improving
                                security and encryption — and also adding
                                features. Best mates right?
                            </span>
                        </main>
                        <footer>
                            <div>
                                <span class="w-12 h-12 bg-orange-600 text-white p-2 rounded-full mb-3 mx-auto flex items-center justify-center">
                                    BM
                                </span>
                            </div>
                            <div>
                                <span class="font-semibold">
                                    Bennie Maddock
                                </span>
                            </div>
                            <div class="text-sm">Instagram</div>
                        </footer>
                    </div>
                </div>

                <div
                    class="absolute left-0 top-1/2 translate-y-1/2 cursor-pointer transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-x-2"
                    @click="current = current === 0 ? total - 1 : current - 1"
                >
                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-left-02 text-4xl"></i>
                </div>

                <!-- Arrow right -->
                <div
                    class="absolute right-0 top-1/2 translate-y-1/2 cursor-pointer transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:translate-x-2"
                    @click="current = current === total - 1 ? 0 : current + 1"
                >
                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-right-02 text-4xl"></i>
                </div>
            </div>

            <!-- Controls Container -->
            <div class="flex items-center justify-center mt-8">
                <!-- Circles determines review is active or selected -->
                <div class="flex gap-2">
                    <template x-for="i in total" :key="i">
                        <span
                            class="w-4 h-4 rounded-full cursor-pointer transition-colors"
                            :class="current === i - 1 ? 'bg-[#252525]' : 'bg-gray-300'"
                            @click="current = i - 1"
                        ></span>
                    </template>
                </div>
            </div>
        </div>

        <div class="text-center mt-20">
            <a class="btn" href="/reviews">
                Learn more
            </a>
        </div>
    </section>
</section>
