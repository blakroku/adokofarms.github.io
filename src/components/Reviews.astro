                            <div class="text-2xl">
                                ★★★★★
                            </div>

                            <span class="block text-sm font-medium text-gray-900">
                                <img
                                        src={brandGoogle.src}
                                        alt="Google Review"
                                        width="30"
                                >
                            </span>

