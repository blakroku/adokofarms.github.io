---
import { astro } from "astro/hono";

const { heroTitle, firstHeroTitle, secondHeroTitle } = Astro.props;
---

<section>
    <div class="bg-[#252525] container mx-auto px-12 md:px-0 pt-18 h-150 sm:h-200 md:mb-22 rounded-none sm:rounded-4xl bg-[url('../assets/ad2.png')] bg-cover bg-center overflow-hidden relative">
        <div class="flex justify-center mb-3">
            <div class="border-2 text-white font-semibold border-white inline-flex justify-center px-5 py-2 rounded-full text-sm tracking-widest uppercase">
                {heroTitle}
            </div>
        </div>

        <h1 class="text-center text-white hero-font-style">
            <span class="block">{firstHeroTitle}</span>
            <span class="block">{secondHeroTitle}</span>
            <!-- <span class="text-wrap">
                {firstHeroTitle} {secondHeroTitle}
            </span> -->
        </h1>
    </div>
</section>
