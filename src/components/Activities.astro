---
import Button from "./utilities/Button.astro";
---

<section class="py-32">
    <div class="container mx-auto px-4">
        <!-- Header -->
        <!-- <header class="text-center text-[#4B515F] max-w-2xl mx-auto mb-12">
            <div class="container-content mx-auto mb-12 text-gray-800 text-center">
                <h2 class="uppercase font-light text-xl">Choose your escape</h2>
                <p class="mt-3 font-light lavish-description">
                    Authentic adventures
                </p>
            </div>

            <a href="/activities" class="activity-link">
                View all activities
            </a>
        </header> -->

        <header class="flex justify-between items-center mb-6 px-4 md:px-20">
            <div>
                <h3 class="text-5xl font-semibold header-level-3">
                    Activities
                </h3>
            </div>
            <div>
                <a href="/activities" class="hover:underline">
                    View all activities
                </a>
            </div>
        </header>

        <!-- Activities -->
        <div class="flex items-center gap-6 relative">
            <!-- Left Arrow -->
            <button
                id="activities-prev"
                type="button"
                class="btn-rounded"
                aria-label="Previous experiences"
            >
                <i class="hgi hgi-stroke hgi-rounded hgi-arrow-left-01 text-4xl font-bold"></i>
            </button>

            <!-- Scrollable Activities -->
            <div
                id="activities"
                class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory
                       flex-1 min-w-0 scrollbar-hidden"
            >
                <!-- Card 1 -->
                <div
                    class="relative aspect-4/5 w-full sm:w-[48%] lg:w-[calc(33.333%-16px)]
                           shrink-0 snap-start rounded-3xl bg-[url('../assets/farm-stay.png')] bg-cover bg-center overflow-hidden"
                >
                    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>

                    <div class="absolute inset-x-0 bottom-0 p-6 text-white">
                        <h3 class="text-2xl font-medium">Farm Stays</h3>

                        <p class="mt-2 text-sm text-white/80">
                            From <span class="text-white">$90</span>/pp
                        </p>

                        <div class="flex items-center justify-between mt-5">
                            <span class="text-sm text-white/70">± 1 hour</span>

                            <a href="#" class="btn">
                                Book Now
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Card 2 -->
                <div
                    class="relative aspect-4/5 w-full sm:w-[48%] lg:w-[calc(33.333%-16px)]
                           shrink-0 snap-start rounded-3xl bg-[url('../assets/hero.png')] bg-cover bg-center overflow-hidden"
                >
                    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>

                    <div class="absolute inset-x-0 bottom-0 p-6 text-white">
                        <h3 class="text-2xl font-medium">Camping</h3>

                        <p class="mt-2 text-sm text-white/80">
                            From <span class="text-white">$85</span>/pp
                        </p>

                        <div class="flex items-center justify-between mt-5">
                            <span class="text-sm text-white/70">± 2 hours</span>

                            <a href="#" class="btn">
                                Book Now
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Card 3 -->
                <div
                    class="relative aspect-4/5 w-full sm:w-[48%] lg:w-[calc(33.333%-16px)]
                           shrink-0 snap-start rounded-3xl bg-[url('../assets/family-farm-tours.png')] bg-cover bg-center overflow-hidden"
                >
                    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>

                    <div class="absolute inset-x-0 bottom-0 p-6 text-white">
                        <h3 class="text-2xl font-medium">Family farm tour</h3>

                        <p class="mt-2 text-sm text-white/80">
                            From <span class="text-white">$85</span>/pp
                        </p>

                        <div class="flex items-center justify-between mt-5">
                            <span class="text-sm text-white/70">
                                Guided Farm Tours
                            </span>

                            <a href="#" class="btn">
                                Book Now
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Card 4 -->
                <div
                    class="relative aspect-4/5 w-full sm:w-[48%] lg:w-[calc(33.333%-16px)]
                           shrink-0 snap-start rounded-3xl bg-[url('../assets/farm-table.png')] bg-cover bg-center overflow-hidden"
                >
                    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>

                    <div class="absolute inset-x-0 bottom-0 p-6 text-white">
                        <h3 class="text-2xl font-medium">
                            Farm To Table Dining
                        </h3>

                        <p class="mt-2 text-sm text-white/80">
                            From <span class="text-white">$70</span>/pp
                        </p>

                        <div class="flex items-center justify-between mt-5">
                            <span class="text-sm text-white/70">± 3 hours</span>

                            <a href="#" class="btn">
                                Book Now
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Card 5 -->
                <div
                    class="relative aspect-4/5 w-full sm:w-[48%] lg:w-[calc(33.333%-16px)]
                           shrink-0 snap-start rounded-3xl bg-[url('../assets/nature-exp.png')] bg-cover bg-center overflow-hidden"
                >
                    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>

                    <div class="absolute inset-x-0 bottom-0 p-6 text-white">
                        <h3 class="text-2xl font-medium">Nature Experiences</h3>

                        <p class="mt-2 text-sm text-white/80">
                            From <span class="text-white">$95</span>/pp
                        </p>

                        <div class="flex items-center justify-between mt-5">
                            <span class="text-sm text-white/70">± 4 hours</span>

                            <a href="#" class="btn">
                                Book Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Arrow -->
            <button
                id="activities-next"
                type="button"
                class="btn-rounded"
                aria-label="Next experiences"
            >
                <i class="hgi hgi-stroke hgi-rounded hgi-arrow-right-01 text-4xl font-bold"></i>
            </button>
        </div>
    </div>
</section>

<script>
    const activities = document.getElementById("activities");
    const next = document.getElementById("activities-next");
    const prev = document.getElementById("activities-prev");

    next?.addEventListener("click", () => {
        activities?.scrollBy({
            left: activities.clientWidth,
            behavior: "smooth",
        });
    });

    prev?.addEventListener("click", () => {
        activities?.scrollBy({
            left: -activities.clientWidth,
            behavior: "smooth",
        });
    });
</script>

<style>
    .scrollbar-hidden {
        scrollbar-width: none;
    }

    .scrollbar-hidden::-webkit-scrollbar {
        display: none;
    }
</style>
