---
const { name, bg, border, hoverBg, hoverText } = Astro.props;
---

<button
    style={`--button-bg: ${bg}; border: 1px solid ${border}; --hover-bg: ${hoverBg}; --hover-text: ${hoverText}`}
>
    {name}
</button>

<style>
    button {
        position: relative;
        /*isolation: isolate;*/
        /*z-index: 0;*/
        border-radius: 1.125rem;
        /*border: 1px solid #252525;*/
        cursor: pointer;
        padding: 0.875rem 1.5rem;
        font-weight: 350;
        color: #252525;
        background-color: var(--button-bg);
    }

    button::before {
        content: "";
        position: absolute;
        bottom: -0.25rem;
        right: -0.25rem;
        height: 100%;
        width: 100%;
        border-radius: 1rem;
        background-color: #252525;
        z-index: -1;

        opacity: 0;
        transform: scale(0.9);
        transition:
            opacity 250ms ease,
            transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    button:hover::before {
        opacity: 1;
        transform: scale(1);
    }
</style>
