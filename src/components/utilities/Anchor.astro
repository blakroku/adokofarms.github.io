---
const { name, bg, border, hoverBg, hoverText } = Astro.props;
---

<a
    href="/"
    style={`--button-bg: ${bg}; border: 1px solid ${border}; --hover-bg: ${hoverBg}; --hover-text: ${hoverText}`}
>
    {name}
</a>

<style>
    .btn {
        position: relative;
        isolation: isolate;
        border-radius: 1.125rem;
        cursor: pointer;
        /*padding: 0.875rem 1.5rem;*/
        font-weight: 350;
        color: #252525;
        background-color: transparent; /* the face now lives on ::after */
    }

    /* the face (the visible button) */
    .btn::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 1.125rem;
        background-color: var(--button-bg);
        z-index: -1;
    }

    /* the hidden shadow layer, behind the face */
    .btn::before {
        content: "";
        position: absolute;
        bottom: -0.25rem;
        right: -0.25rem;
        height: 100%;
        width: 100%;
        border-radius: 1.125rem;
        background-color: #252525;
        z-index: -2;

        opacity: 0;
        transform: scale(0.9);
        transition:
            opacity 250ms ease,
            transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .btn:hover::before {
        opacity: 1;
        transform: scale(1);
    }
</style>
