                                    <span>About Adoko Farms</span>
                                </a>
                            </li>
                            <li>
                                <a
                                    href="/reviews"
                                    class="flex items-center gap-2 px-6 py-3"
                                >
                                    <span>
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="22"
                                            height="22"
