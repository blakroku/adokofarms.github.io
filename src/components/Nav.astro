                                        </svg>
                                    </span>
                                    <span>FAQs</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li>
                    <a
                        href="/contact"
                        class="flex items-center gap-2 px-6 py-3 text-xl"
                    >
                        <span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
