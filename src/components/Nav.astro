---
import astroLogo from "../assets/astro.svg";
import adokofarmsLogo from "../assets/adokofarmslogo.png";
import background from "../assets/background.svg";
import messenger from "../assets/messenger.webp";

const whatsappMe = "https://wa.me/233535180741";
---

<header
    x-data="{ openMenu: false, openResourceMenu: false }"
    class="px-4 sm:px-0 border-b border-stone-200"
>
    <nav class="container mx-auto flex items-center justify-between py-4">
        <div class="text-black uppercase text-xl font-black">
            <a href="/">Adoko Farms</a>
        </div>

        <button
            @click="openMenu = !openMenu"
            type="button"
            class="px-5 py-2 rounded-xl flex items-center gap-2 cursor-pointer text-black bg-white hover:bg-blue-800 hover:text-white"
        >
            <!-- <span class="flex flex-col gap-1">
                <span class="block w-5 h-0.5 bg-black"></span>
                <span class="block w-5 h-0.5 bg-black"></span>
                <span class="block w-5 h-0.5 bg-black"></span>
            </span> -->

            <span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="size-6"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                    />
                </svg>
            </span>

            <span class="">Menu</span>
        </button>
    </nav>

    <!-- Content -->

    <!-- Overlay -->
    <div
        x-show="openMenu"
        class="fixed inset-0 z-40 bg-black/30 bg-opacity-10"
    ></div>

    <!-- Drawer -->
    <div
        x-show="openMenu"
        class="fixed inset-y-0 right-0 z-50 w-full sm:w-[25%] bg-[#F9F8F0]"
        :class="{'translate-x-0': openMenu, 'translate-x-full': !openMenu}"
        style="transition: transform 0.3s ease;"
    >
        <button
            @click="openMenu = false"
            class="absolute top-6 right-6 text-black text-2xl cursor-pointer"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-9"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                />
            </svg>
        </button>

        <nav class="mt-16">
            <ul class="text-black">
                <li>
                    <a href="/" class="block px-6 py-3">
                        Home
                    </a>
                </li>
                <li>
                    <a href="/tours" class="block px-6 py-3">
                        Tours
                    </a>
                </li>
                <li>
                    <a href="/activities" class="block px-6 py-3">
                        Activities
                    </a>
                </li>
                <li>
                    <button
                        type="button"
                        class="flex justify-between items-center px-6 py-3 cursor-pointer w-full"
                        @click="openResourceMenu = !openResourceMenu"
                    >
                        <span>Resources</span>
                        <span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="size-6"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"
                                />
                            </svg>
                        </span>
                    </button>
                    <div x-show="openResourceMenu">
                        <ul>
                            <li>
                                <a href="/about" class="block px-6 py-3">
                                    About Adoko Farms
                                </a>
                            </li>
                            <li>
                                <a href="/reviews" class="block px-6 py-3">
                                    Reviews
                                </a>
                            </li>
                            <li>
                                <a href="/directions" class="block px-6 py-3">
                                    Directions
                                </a>
                            </li>
                            <li>
                                <a href="/blog" class="block px-6 py-3">
                                    Blog
                                </a>
                            </li>
                            <li>
                                <a href="/faqs" class="block px-6 py-3">
                                    FAQs
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li>
                    <a href="/contact" class="block px-6 py-3">
                        Contact
                    </a>
                </li>
                <li class="mt-12">
                    <a
                        href={whatsappMe}
                        class="px-6 py-3 bg-[#003964] text-white flex items-center gap-2"
                        target="_blank"
                    >
                        <span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="size-6"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z"
                                />
                            </svg>
                        </span>
                        <span class="font-light">Book Your Experience</span>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Mobile navigation footer -->
        <footer class="px-4 md:hidden bg-white text-black">
            <section class="p-12 mt-12 rounded-md">
                <header class="flex gap-4">
                    <div>
                        <img
                            src={messenger.src}
                            class="inline-block w-28 rounded-full"
                        />
                    </div>
                    <div>
                        <div class="mb-3 text-sm uppercase font-bold">
                            Need any help?
                        </div>
                        <div class="text-sm mb-8">
                            From bookings to general enquiries and anything in
                            between, our team are on hand to help.
                        </div>
                    </div>
                </header>
                <div class="space-y-2">
                    <a
                        href="https://wa.me/233535180741"
                        class="block text-center rounded-sm text-sm px-4 py-1.5 w-full font-light bg-[#003964] text-white"
                    >
                        Talk to us
                    </a>
                    <a
                        href="/contact"
                        class="block text-center rounded-sm text-sm px-4 py-1.5 w-full font-light bg-[#003964] text-white"
                    >
                        Send Enquiry
                    </a>
                </div>
            </section>
        </footer>
    </div>
</header>
