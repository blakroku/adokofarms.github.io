---
import astroLogo from "../assets/astro.svg";
import adokofarmsLogo from "../assets/adokofarmslogo.png";
import background from "../assets/background.svg";

const whatsappMe = "https://wa.me/233535180741";
---

<header
    x-data="{ openMenu: true, openResourceMenu: true }"
    class="px-4 sm:px-0"
>
    <nav class="container mx-auto flex items-center justify-between py-4">
        <div class="text-black uppercase text-xl font-black">Adoko Farms</div>

        <button
            @click="openMenu = !openMenu"
            type="button"
            class="px-5 py-2 rounded-xl flex items-center gap-2 cursor-pointer text-black bg-white hover:bg-blue-800 hover:text-white"
        >
            <!-- <span class="flex flex-col gap-1">
                <span class="block w-5 h-0.5 bg-black"></span>
                <span class="block w-5 h-0.5 bg-black"></span>
                <span class="block w-5 h-0.5 bg-black"></span>
            </span> -->

            <span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="size-6"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                    />
                </svg>
            </span>

            <span class="">Menu</span>
        </button>
    </nav>

    <!-- Content -->

    <!-- Overlay -->
    <div
        x-show="openMenu"
        class="fixed inset-0 z-40 bg-black/30 bg-opacity-10"
    ></div>

    <!-- Drawer -->
    <div
        x-show="openMenu"
        class="fixed inset-y-0 right-0 z-50 w-full sm:w-[25%] bg-[#F9F8F0]"
        :class="{'translate-x-0': openMenu, 'translate-x-full': !openMenu}"
        style="transition: transform 0.3s ease;"
    >
        <button
            @click="openMenu = false"
            class="absolute top-6 right-6 text-black text-2xl cursor-pointer"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-9"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                />
            </svg>
        </button>

        <nav class="mt-16">
            <ul class="text-black">
                <li>
                    <a href="/" class="block px-6 py-3">
                        Home
                    </a>
                </li>
                <li>
                    <a href="/tours" class="block px-6 py-3">
                        Tours
                    </a>
                </li>
                <li>
                    <a href="/activities" class="block px-6 py-3">
                        Activities
                    </a>
                </li>
                <li>
                    <button
                        type="button"
                        class="flex justify-between items-center px-6 py-3 cursor-pointer w-full"
                        @click="openResourceMenu = !openResourceMenu"
                    >
                        <span>Resources</span>
                        <span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="size-6"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"
                                />
                            </svg>
                        </span>
                    </button>
                    <div x-show="openResourceMenu">
                        <ul>
                            <li>
                                <a href="/about" class="block px-6 py-3">
                                    About Adoko Farms
                                </a>
                            </li>
                            <li>
                                <a href="/reviews" class="block px-6 py-3">
                                    Reviews
                                </a>
                            </li>
                            <li>
                                <a href="/directions" class="block px-6 py-3">
                                    Directions
                                </a>
                            </li>
                            <li>
                                <a href="/blog" class="block px-6 py-3">
                                    Blog
                                </a>
                            </li>
                            <li>
                                <a href="/faqs" class="block px-6 py-3">
                                    FAQs
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li>
                    <a href="/contact" class="block px-6 py-3">
                        Contact
                    </a>
                </li>
                <li>
                    <a
                        href={whatsappMe}
                        class="block px-6 py-3 bg-[#003964] text-white"
                        target="_blank"
                    >
                        Book now
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</header>
