---
import astroLogo from "../assets/astro.svg";
import background from "../assets/background.svg";
import messenger from "../assets/messenger.webp";
import sonar from "../assets/sonar.svg";
import Brand from "./utilities/brand.astro";

const whatsappMe = "https://wa.me/233535180741";
---

<header
    x-data="{ openMenu: false, openResourceMenu: false }"
    class="px-4 sm:px-0 border-b border-stone-200"
>
    <nav class="container mx-auto flex items-center justify-between py-4">
        <Brand />
        <button
            @click="openMenu = !openMenu"
            type="button"
            class="btn px-3 py-1 rounded-full flex items-center gap-2 cursor-pointer text-black bg-white hover:bg-[#252525] hover:text-white"
        >
            <!-- <span class="flex flex-col gap-0.5">
                <span class="block w-5 h-1 rounded-full bg-black hover:bg-white"></span>
                <span class="block w-5 h-1 rounded-full bg-black"></span>
                <span class="block w-5 h-1 rounded-full bg-black"></span>
            </span> -->

            <span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="size-6"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                    />
                </svg>
            </span>

            <span class="font-light sm:font-semibold">Menu</span>
        </button>
    </nav>

    <!-- Content -->

    <!-- Overlay -->
    <div
        x-show="openMenu"
        class="fixed inset-0 z-40 bg-black/30 bg-opacity-10"
    ></div>

    <!-- Drawer -->
    <div
        x-show="openMenu"
        class="fixed inset-y-0 right-0 z-50 w-full sm:w-[25%] bg-[#F9F8F0]"
        :class="{'translate-x-0': openMenu, 'translate-x-full': !openMenu}"
        style="transition: transform 0.3s ease;"
    >
        <button
            @click="openMenu = false"
            class="btn-rounded absolute! top-6! right-6! text-black! text-2xl! cursor-pointer!"
        >
            <i class="hgi hgi-stroke hgi-rounded hgi-cancel-01 text-4xl"></i>
        </button>

        <nav class="mt-16">
            <ul class="text-black">
                <li>
                    <a
                        href="/"
                        class="flex items-center gap-2 px-6 py-3 text-xl"
                    >
                        <span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="22"
                                height="22"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-home"
                            >
                                <path
                                    stroke="none"
                                    d="M0 0h24v24H0z"
                                    fill="none"
                                />
                                <path d="M5 12l-2 0l9 -9l9 9l-2 0" />
                                <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" />
                                <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" />
                            </svg>
                        </span>
                        <span>Home</span>
                    </a>
                </li>
                <li>
                    <a
                        href="/tours"
                        class="flex items-center gap-2 px-6 py-3 text-xl"
                    >
                        <span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="22"
                                height="22"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-directions"
