---
// import demoImage from "../assets/demo.webp";
import demoImage from "../assets/hero.png";
import demoImage2 from "../assets/hero2.png";
import demoImage3 from "../assets/hero3.png";
---

<section class="py-32 bg-white">
    <div class="w-full md:container md:mx-auto px-4">
        <header>
            <div class="mb-8">
                <h3 class="text-5xl font-semibold header-level-3 mb-2">
                    Our Experience
                </h3>
                <div>Mark your calendar for a great experience.</div>
            </div>
        </header>
        <main class="mb-12 flex flex-col md:flex-row gap-4">
            <!-- first box -->
            <div class="relative w-full md:w-full lg:w-1/2">
                <div class="mb-3">
                    <img
                        class="rounded-xl"
                        src={demoImage.src}
                        alt="Boat ride"
                    />
                </div>
                <div class="mb-3">
                    <span class="text-gray-500">September 26, 2026</span>
                </div>
                <div class="mb-6">
                    <a
                        href="/experience-adoko-farms"
                        class="text-xl font-semibold"
                    >
                        Experience Odwira in Akropong and stay in the peaceful
                        surroundings of Adoko Farms.
                    </a>
                </div>
                <div>
                    <a href="https://wa.me/054">Book now</a>
                </div>

                <!-- Status -->
                <span class="absolute inline-block top-3 left-3 bg-white px-3 py-1.2 rounded-full">
                    Current experiece
                </span>
            </div>

            <!-- Second box -->
            <div class="flex flex-col md:flex-row gap-4 w-full md:w-full lg:w-1/2">
                <div class="relative w-full md:w-[50%]">
                    <div class="mb-3">
                        <img
                            class="rounded-xl"
                            src={demoImage2.src}
                            alt="Beach joy"
                        />
                    </div>
                    <div class="mb-6">
                        <a
                            href="/experience-odwira-tour"
                            class="text-xl font-light"
                        >
                            At Adoko Farms, Akropong–Akuapim, we design each
                            stay around safety, comfort, calm, and thoughtful
                            pacing — not just tents.
                        </a>
                    </div>

                    <!-- Status -->
                    <span class="absolute inline-block top-3 left-3 bg-[#252525] text-white px-3 py-1.2 rounded-full">
                        Past experiece
                    </span>
                </div>

                <div class="relative w-full md:w-[50%]">
                    <div class="mb-3">
                        <img
                            class="rounded-xl"
                            src={demoImage3.src}
                            alt="Mountain trek"
                        />
                    </div>
                    <div class="mb-6">
                        <a
                            href="/experience-natural-tour"
                            class="text-xl font-light"
                        >
                            Explore Ghana's natural landscapes and experience
                            the country's wildlife away from the crowds.
                        </a>
                    </div>

                    <!-- Status -->
                    <span class="absolute inline-block top-3 left-3 bg-[#252525] text-white px-3 py-1.2 rounded-full">
                        Past experiece
                    </span>
                </div>
            </div>
        </main>
        <footer>
            <div class="md:flex md:justify-end">
                <a
                    href="/tours"
                    class="hover:underline bg-[#252525] text-white px-4 py-2 rounded-full inline-flex items-center gap-2"
                >
                    <span>View all</span>
                    <span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="size-6"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"
                            />
                        </svg>
                    </span>
                </a>
            </div>
        </footer>
    </div>
</section>
