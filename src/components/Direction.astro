<section class="map-section">
    <div id="map"></div>

    <div class="map-controls">
        <input id="origin" type="text" placeholder="Enter your location" />

        <button id="locate" type="button">
            Use my location
        </button>

        <button id="route" type="button">
            Get directions
        </button>
    </div>

    <div id="route-info" class="route-info" hidden>
        <div>
            <span>Distance</span>
            <strong id="distance"></strong>
        </div>

        <div>
            <span>Driving time</span>
            <strong id="duration"></strong>
        </div>
    </div>
</section>

<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    .map-section {
        position: relative;
        width: 100%;
        height: 700px;
    }

    #map {
        width: 100%;
        height: 100%;
    }

    .map-controls {
        position: absolute;
        z-index: 1000;

        top: 20px;
        left: 20px;

        display: flex;
        gap: 8px;

        width: min(700px, calc(100% - 40px));

        padding: 10px;

        background: white;
        border-radius: 12px;

        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.15);
    }

    .map-controls input {
        flex: 1;

        height: 46px;

        min-width: 0;

        padding: 0 14px;

        border: 1px solid #ddd;
        border-radius: 8px;

        outline: none;
    }

    .map-controls input:focus {
        border-color: #111;
    }

    .map-controls button {
        height: 46px;

        border: 0;
        border-radius: 8px;

        padding: 0 16px;

        cursor: pointer;

        font-size: 14px;
        font-weight: 600;

        white-space: nowrap;
    }

    #locate {
        background: #f1f1f1;
        color: #111;
    }

    #route {
        background: #111;
        color: white;
    }

    .map-controls button:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    /*
     * Route information
     */

    .route-info {
        position: absolute;

        z-index: 1000;

        left: 20px;
        bottom: 20px;

        display: flex;
        gap: 30px;

        padding: 16px 20px;

        background: white;

        border-radius: 12px;

        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.15);
    }

    .route-info span {
        display: block;

        margin-bottom: 4px;

        color: #777;

        font-size: 11px;
        font-weight: 600;

        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .route-info strong {
        font-size: 18px;
    }

    @media (max-width: 700px) {
        .map-section {
            height: 600px;
        }

        .map-controls {
            flex-direction: column;
        }

        .map-controls input,
        .map-controls button {
            width: 100%;
            height: 46px;
        }

        .route-info {
            right: 20px;

            justify-content: space-between;
        }
    }
</style>

<script>
    /*
     * STATIC DESTINATION
     *
     * This is ALWAYS the destination.
     * Replace these with the exact coordinates
     * of Adoko Farms.
     */

    const FARM = {
        lat: 6.2915,
        lng: -0.2598,
    };

    /*
     * Create map
     */

    const map = L.map("map").setView([FARM.lat, FARM.lng], 13);

    /*
     * OpenStreetMap
     */

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap contributors",
    }).addTo(map);

    /*
     * STATIC FARM MARKER
     */

    L.marker([FARM.lat, FARM.lng])
        .addTo(map)
        .bindPopup("Adoko Farms")
        .openPopup();

    /*
     * Route
     */

    let routeLayer = null;

    /*
     * Visitor marker
     */

    let originMarker = null;

    /*
     * Calculate route
     *
     * origin = visitor
     * destination = FARM
     */

    async function calculateRoute(latitude, longitude) {
        const routeButton = document.getElementById("route");

        routeButton.disabled = true;
        routeButton.textContent = "Calculating...";

        try {
            const url =
                `https://router.project-osrm.org/route/v1/driving/` +
                `${longitude},${latitude};` +
                `${FARM.lng},${FARM.lat}` +
                `?overview=full&geometries=geojson`;

            const response = await fetch(url);

            if (!response.ok) {
                throw new Error("Routing request failed");
            }

            const data = await response.json();

            if (data.code !== "Ok") {
                throw new Error("No route found");
            }

            const route = data.routes[0];

            /*
             * Remove previous route
             */

            if (routeLayer) {
                map.removeLayer(routeLayer);
            }

            /*
             * Remove previous origin marker
             */

            if (originMarker) {
                map.removeLayer(originMarker);
            }

            /*
             * Add visitor marker
             */

            originMarker = L.marker([latitude, longitude])
                .addTo(map)
                .bindPopup("Your location");

            /*
             * Draw route
             */

            routeLayer = L.geoJSON(route.geometry, {
                style: {
                    color: "#111",
                    weight: 5,
                    opacity: 0.9,
                },
            }).addTo(map);

            /*
             * Fit entire route
             */

            map.fitBounds(routeLayer.getBounds(), {
                padding: [80, 80],
            });

            /*
             * Route information
             */

            const distance = (route.distance / 1000).toFixed(1);

            const duration = Math.round(route.duration / 60);

            document.getElementById("distance").textContent = `${distance} km`;

            document.getElementById("duration").textContent =
                formatDuration(duration);

            document.getElementById("route-info").hidden = false;
        } catch (error) {
            console.error(error);

            alert("Unable to find a route from this location.");
        } finally {
            routeButton.disabled = false;
            routeButton.textContent = "Get directions";
        }
    }

    /*
     * Format driving time
     */

    function formatDuration(minutes) {
        if (minutes < 60) {
            return `${minutes} min`;
        }

        const hours = Math.floor(minutes / 60);

        const remaining = minutes % 60;

        if (!remaining) {
            return `${hours} hr`;
        }

        return `${hours} hr ${remaining} min`;
    }

    /*
     * USE MY LOCATION
     */

    document.getElementById("locate").addEventListener("click", () => {
        if (!navigator.geolocation) {
            alert("Your browser does not support location services.");

            return;
        }

        const button = document.getElementById("locate");

        button.disabled = true;
        button.textContent = "Finding location...";

        navigator.geolocation.getCurrentPosition(
            (position) => {
                const lat = position.coords.latitude;

                const lng = position.coords.longitude;

                document.getElementById("origin").value = "My current location";

                button.disabled = false;
                button.textContent = "Use my location";

                /*
                 * Immediately calculate
                 * route to the STATIC farm.
                 */

                calculateRoute(lat, lng);
            },

            () => {
                button.disabled = false;
                button.textContent = "Use my location";

                alert("Unable to access your location.");
            },

            {
                enableHighAccuracy: true,
                timeout: 10000,
                maximumAge: 0,
            },
        );
    });

    /*
     * MANUAL LOCATION
     *
     * Only the origin is geocoded.
     * FARM is never geocoded.
     */

    document.getElementById("route").addEventListener("click", async () => {
        const input = document.getElementById("origin");

        const location = input.value.trim();

        if (!location) {
            input.focus();
            return;
        }

        const button = document.getElementById("route");

        button.disabled = true;
        button.textContent = "Finding location...";

        try {
            /*
             * Convert visitor's
             * address to coordinates.
             */

            const response = await fetch(
                "https://nominatim.openstreetmap.org/search?" +
                    new URLSearchParams({
                        q: location,
                        format: "json",
                        limit: "1",
                    }),
            );

            if (!response.ok) {
                throw new Error("Geocoding failed");
            }

            const results = await response.json();

            if (!results.length) {
                alert("Location not found.");

                return;
            }

            const latitude = parseFloat(results[0].lat);

            const longitude = parseFloat(results[0].lon);

            /*
             * Route from visitor's
             * location → STATIC FARM.
             */

            await calculateRoute(latitude, longitude);
        } catch (error) {
            console.error(error);

            alert("Unable to find that location.");
        } finally {
            button.disabled = false;
            button.textContent = "Get directions";
        }
    });
</script>
