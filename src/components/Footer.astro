    <!-- Main Footer -->
    <div class="container mx-auto px-12 py-20 bg-[#252525] rounded-2xl text-white/60">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
            <!-- Brand -->
            <div class="lg:col-span-6">
                <div class="mb-6">
                    <a href="/" class="text-2xl font-medium">
                        About Adoko Farms
                    </a>
                </div>

                <p class="leading-relaxed max-w-sm">
                    We are working farm and agrotourism destination in
                    Akropong-Akuapem, about 54km from Accra. We offer farm
                    stays, camping, guided farm tours, farm-to-table dining,
                    nature experiences and relaxing day visits for families,
                    couples, schools and small groups.
                </p>

                <div class="flex items-center gap-2 mt-8">
                    <Arrow color="#F54A00" />

                    <a
                        href="/about"
                        class="text-sm border-b border-white/40 pb-1 font-light"
                    >
                        <span class="text-[#F54A00]">
                            Discover our experiences
                        </span>
                    </a>
                </div>
            </div>

            <!-- Explore -->
            <div class="lg:col-span-2">
                <h3 class="text-xl font-light mb-6">Explore</h3>

                <nav class="flex flex-col gap-4">
                    <a href="/tours" class="hover:text-white transition">
                        Tours
                    </a>

                    <a href="/activities" class="hover:text-white transition">
                        Activities
                    </a>

                    <!-- <a href="/gallery" class="hover:text-white transition">
                        Gallery
                    </a> -->

                    <a href="/about" class="hover:text-white transition">
                        About us
                    </a>

                    <a href="/contact" class="hover:text-white transition">
                        Contact
                    </a>
                </nav>
            </div>

            <!-- Resources -->
            <div class="lg:col-span-2">
                <h3 class="text-xl font-light mb-6">Resources</h3>

                <nav class="flex flex-col gap-4">
                    <a href="/blog" class="hover:text-white transition">
                        Blog
                    </a>

                    <a href="/faqs" class="hover:text-white transition">
                        FAQs
                    </a>

                    <a href="/directions" class="hover:text-white transition">
                        Directions
                    </a>

                    <a href="/reviews" class="hover:text-white transition">
                        Reviews
                    </a>
                </nav>
            </div>

            <!-- Contact -->
            <div class="lg:col-span-2">
                <h3 class="text-xl font-light mb-6">Let's connect</h3>

                <!-- Social -->
                <div class="flex flex-col gap-4 mt-8">
                    <a
                        href="https://www.instagram.com/adokofarms"
                        class="flex gap-2 items-center font-light"
                    >
                        <span class="text-white">
                            <i class="hgi hgi-stroke hgi-rounded hgi-instagram text-4xl"></i>
                        </span>
                        <span class="font-light text-white/60">Instagram</span>
                    </a>

                    <a
                        href="https://www.facebook.com/adokofarms"
                        class="flex gap-2 items-center"
                        target="_blank"
                    >
                        <span class="text-white">
                            <i class="hgi hgi-stroke hgi-rounded hgi-facebook-01 text-4xl"></i>
                        </span>
                        <span class="font-light text-white/60">Facebook</span>
                    </a>

                    <a
                        href="https://wa.me/233535180741"
                        class="flex gap-2 items-center"
                        target="_blank"
                    >
                        <span class="text-white">
                            <i class="hgi hgi-stroke hgi-rounded hgi-whatsapp text-4xl"></i>
                        </span>
                        <span class="font-light text-white/60">Whatsapp</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom -->
    <div class="container mx-auto border-t border-white/10 mt-3 pt-6 text-[#908d95] px-4 sm:px-0 text-sm">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex gap-6">
                <p class="text-[#180148]">
                    &copy; {new Date().getFullYear()} Adoko Farms
                </p>

                <a href="#" class="hover:text-gray-700 transition">
                    Privacy Policy
                </a>

                <!-- <a href="#" class="hover:text-gray-700 transition">
                    Terms & Conditions
                </a> -->
            </div>
        </div>
