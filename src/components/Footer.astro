        <!-- Bottom -->
        <div class="border-t border-white/10 mt-12 pt-6">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <p class="text-xs text-white/40">
                    © {new Date().getFullYear()} Adoko Farms. All rights
