---

---

<footer class="bg-black text-white">

    <!-- Main Footer -->
    <div class="container mx-auto px-6 py-20">

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16">

            <!-- Brand -->
            <div class="lg:col-span-1">

                <div class="mb-6">
                    <a href="/" class="text-2xl font-medium">
                        Adoko Farms
                    </a>
                </div>

                <p class="text-white/60 leading-relaxed max-w-sm">
                    Experience rural Ghana through authentic stays,
                    local culture, nature, and unforgettable experiences.
                </p>

                <a
                        href="#"
                        class="inline-flex items-center gap-2 mt-8 text-sm border-b border-white/40 pb-1"
                >
                    Discover our experiences

                    <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="size-4"
                    >
                        <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"
                        />
                    </svg>
                </a>

            </div>


            <!-- Explore -->
            <div>

                <h3 class="text-sm font-medium mb-6">
                    Explore
                </h3>

                <nav class="flex flex-col gap-4 text-sm text-white/60">

                    <a href="#" class="hover:text-white transition">
                        Experiences
                    </a>

                    <a href="#" class="hover:text-white transition">
                        Accommodation
                    </a>

                    <a href="#" class="hover:text-white transition">
                        Gallery
                    </a>

                    <a href="#" class="hover:text-white transition">
                        About us
                    </a>

                    <a href="#" class="hover:text-white transition">
                        Contact
                    </a>

                </nav>

            </div>


            <!-- Resources -->
            <div>

                <h3 class="text-sm font-medium mb-6">
                    Resources
                </h3>

                <nav class="flex flex-col gap-4 text-sm text-white/60">

                    <a href="#" class="hover:text-white transition">
                        Travel Guides
                    </a>

                    <a href="#" class="hover:text-white transition">
                        Blog
                    </a>

                    <a href="#" class="hover:text-white transition">
                        FAQs
                    </a>

                    <a href="#" class="hover:text-white transition">
                        Directions
                    </a>

                    <a href="#" class="hover:text-white transition">
                        Reviews
                    </a>

                </nav>

            </div>


            <!-- Contact -->
            <div>

                <h3 class="text-sm font-medium mb-6">
                    Get in touch
                </h3>

                <div class="space-y-4 text-sm text-white/60">

                    <p>
                        Ghana
                    </p>

                    <a
                            href="mailto:hello@adokofarms.com"
                            class="block hover:text-white transition"
                    >
                        hello@adokofarms.com
                    </a>

                    <a
                            href="tel:+233000000000"
                            class="block hover:text-white transition"
                    >
                        +233 00 000 0000
                    </a>

                </div>

                <!-- Social -->
                <div class="flex gap-3 mt-8">

                    <a
                            href="#"
                            aria-label="Instagram"
                            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-black transition"
                    >
                        <span class="text-xs">IG</span>
                    </a>

                    <a
                            href="#"
                            aria-label="Facebook"
                            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-black transition"
                    >
                        <span class="text-xs">FB</span>
                    </a>

                    <a
                            href="#"
                            aria-label="WhatsApp"
                            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-black transition"
                    >
                        <span class="text-xs">WA</span>
                    </a>

                </div>

            </div>

        </div>


        <!-- Newsletter -->
        <div class="border-t border-white/10 mt-20 pt-12">

            <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">

                <div class="max-w-lg">

                    <p class="text-2xl md:text-3xl font-light">
                        Stay connected with Ghana.
                    </p>

                    <p class="mt-3 text-sm text-white/50 leading-relaxed">
                        Get travel inspiration, new experiences and occasional
                        updates from Adoko Farms.
                    </p>

                </div>


                <form class="w-full lg:w-100">

                    <div class="flex border-b border-white/30 pb-3">

                        <input
                                type="email"
                                placeholder="Your email address"
                                class="flex-1 bg-transparent outline-none text-sm
                                   placeholder:text-white/40"
                        />

                        <button
                                type="submit"
                                class="text-sm font-medium hover:text-white/70 transition"
                        >
                            Subscribe
                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- Bottom -->
        <div class="border-t border-white/10 mt-12 pt-6">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

                <p class="text-xs text-white/40">
                    © {new Date().getFullYear()} Adoko Farms. All rights reserved.
                </p>

                <div class="flex flex-wrap gap-6 text-xs text-white/40">

                    <a href="#" class="hover:text-white transition">
                        Privacy Policy
                    </a>

                    <a href="#" class="hover:text-white transition">
                        Terms & Conditions
                    </a>

                </div>

            </div>

        </div>

    </div>

</footer>