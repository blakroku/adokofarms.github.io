---
---

<footer class="bg-[#4B5160] text-white">
    <!-- Main Footer -->
    <div class="container mx-auto px-6 py-20">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16">
            <!-- Brand -->
            <div class="lg:col-span-1">
                <div class="mb-6">
                    <a href="/" class="text-2xl font-medium">
                        Adoko Farms
                    </a>
                </div>

                <p class="text-white/60 leading-relaxed max-w-sm">
                    We are working farm and agrotourism destination in
                    Akropong-Akuapem, about 54km from Accra. We offer farm
                    stays, camping, guided farm tours, farm-to-table dining,
                    nature experiences and relaxing day visits for families,
                    couples, schools and small groups.
                </p>

                <a
                    href="/about"
                    class="inline-flex items-center gap-2 mt-8 text-sm border-b border-white/40 pb-1"
                >
                    Discover our experiences
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-4"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"
                        />
                    </svg>
                </a>
            </div>

            <!-- Explore -->
            <div>
                <h3 class="font-medium mb-6">Explore</h3>

                <nav class="flex flex-col gap-4 text-white/60">
                    <a href="/tours" class="hover:text-white transition">
                        Tours
                    </a>

                    <a href="/activities" class="hover:text-white transition">
                        Activities
                    </a>

                    <!-- <a href="/gallery" class="hover:text-white transition">
                        Gallery
                    </a> -->

                    <a href="/about" class="hover:text-white transition">
                        About us
                    </a>

                    <a href="/contact" class="hover:text-white transition">
                        Contact
                    </a>
                </nav>
            </div>

            <!-- Resources -->
            <div>
                <h3 class="text-sm font-medium mb-6">Resources</h3>

                <nav class="flex flex-col gap-4 text-sm text-white/60">
                    <a href="/blog" class="hover:text-white transition">
                        Blog
                    </a>

                    <a href="/faqs" class="hover:text-white transition">
                        FAQs
                    </a>

                    <a href="/directions" class="hover:text-white transition">
                        Directions
                    </a>

                    <a href="/reviews" class="hover:text-white transition">
                        Reviews
                    </a>
                </nav>
            </div>

            <!-- Contact -->
            <div>
                <h3 class="text-sm font-medium mb-6">Get in touch</h3>

                <div class="space-y-4 text-sm text-white/60">
                    <p>Ghana</p>

                    <a
                        href="mailto:hello@adokofarms.com"
                        class="block hover:text-white transition"
                    >
                        booking@adokofarms.com
                    </a>

                    <a
                        href="tel:+233535180741"
                        class="block hover:text-white transition"
                    >
                        +233 53 518 0741
                    </a>
                </div>

                <!-- Social -->
                <div class="flex gap-3 mt-8">
                    <a
                        href="https://www.instagram.com/adokofarms"
                        target="_blank"
                        aria-label="Instagram"
                        class="w-14 h-14 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-black transition"
                    >
                        <span class="text-xs">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="32"
                                height="32"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="#000000"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                            >
                                <path
                                    stroke="none"
                                    d="M0 0h24v24H0z"
                                    fill="none"
                                />
                                <path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8" />
                                <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                                <path d="M16.5 7.5v.01" />
                            </svg>
                        </span>
                    </a>

                    <a
                        href="https://www.facebook.com/adokofarms/"
                        target="_blank"
                        aria-label="Facebook"
                        class="w-14 h-14 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-black transition"
                    >
                        <span class="text-xs">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="32"
                                height="32"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="#000000"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"
                            >
                                <path
                                    stroke="none"
                                    d="M0 0h24v24H0z"
                                    fill="none"
                                />
                                <path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" />
                            </svg>
                        </span>
                    </a>

                    <a
                        href="https://wa.me/233535180741"
                        target="_blank"
                        aria-label="WhatsApp"
                        class="w-14 h-14 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-black transition"
                    >
                        <span class="text-xs">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="32"
                                height="32"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="#000000"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"
                            >
                                <path
                                    stroke="none"
                                    d="M0 0h24v24H0z"
                                    fill="none"
                                />
                                <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
                                <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
                            </svg>
                        </span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Newsletter -->
