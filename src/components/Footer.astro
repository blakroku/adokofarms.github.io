    <!-- Main Footer -->
    <div class="container mx-auto px-12 py-20 bg-[#252525] rounded-2xl text-white/60">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
            <!-- Brand -->
            <div class="lg:col-span-6">
                <div class="mb-6">
                    <a href="/" class="text-2xl font-medium">
                        Adoko Farms
                    </a>
                </div>

                <p class="leading-relaxed max-w-sm">
                    We are working farm and agrotourism destination in
                    Akropong-Akuapem, about 54km from Accra. We offer farm
                    stays, camping, guided farm tours, farm-to-table dining,
                    nature experiences and relaxing day visits for families,
                    couples, schools and small groups.
                </p>

                <div class="flex items-center gap-2 mt-8">
                    <Arrow color="white" />

                    <a
                        href="/about"
                        class="text-sm border-b border-white/40 pb-1 font-light"
                    >
                        <span>Discover our experiences</span>
                    </a>
                </div>
            </div>

            <!-- Explore -->
            <div class="lg:col-span-2">
                <h3 class="text-xl font-light mb-6">Explore</h3>

                <nav class="flex flex-col gap-4">
                    <a href="/tours" class="hover:text-white transition">
                        Tours
                    </a>

                    <a href="/activities" class="hover:text-white transition">
                        Activities
                    </a>

                    <!-- <a href="/gallery" class="hover:text-white transition">
                        Gallery
                    </a> -->

                    <a href="/about" class="hover:text-white transition">
