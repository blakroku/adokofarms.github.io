---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";
import Hero from "../components/Hero.astro";
import FiveStars from "../components/utilities/FiveStars.astro";
---

<Layout title="Reviews">
    <Page>
        <Hero
            heroTitle="Reviews"
            firstHeroTitle="Stories from"
            secondHeroTitle="our guests"
        />
        <main class="reviews-page">
            <!-- Introduction -->
            <section class="reviews-intro">
                <div class="reviews-container">
                    <div class="reviews-intro-grid">
                        <div>
                            <span class="reviews-number">01</span>
                        </div>

                        <div>
                            <p class="reviews-label">What guests say</p>

                            <h2>Experience worth sharing</h2>

                            <p class="reviews-intro-text">
                                Every visit is different. Some guests come for
                                the countryside, others for the food, the farm,
                                the experiences, or simply a chance to slow
                                down. Here are some of their stories.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Reviews Grid -->
            <section class="reviews-list">
                <div class="reviews-container">
                    <div class="reviews-grid">
                        <article class="review-card">
                            <div class="review-stars">
                                <FiveStars />
                            </div>

                            <blockquote>
                                The perfect place to get away from the city. We
                                loved the peaceful surroundings and the
                                opportunity to spend time in nature.
                            </blockquote>

                            <footer class="text-center">
                                <div>
                                    <span class="w-12 h-12 bg-orange-600 text-white! p-2 rounded-full mb-3 mx-auto flex items-center justify-center">
                                        AA
                                    </span>
                                </div>
                                <div>
                                    <span class="font-semibold">
                                        Abdul Andani
                                    </span>
                                </div>
                                <div class="text-sm">Google Review</div>
                            </footer>
                        </article>

                        <article class="review-card review-card-dark">
                            <span class="review-card-number">02</span>

                            <div class="review-stars">
                                <FiveStars />
                            </div>

                            <blockquote>
                                It felt completely different from a normal hotel
                                stay. The farm environment and the slower pace
                                made the experience really memorable.
                            </blockquote>

                            <footer class="text-center">
                                <div>
                                    <span class="w-12 h-12 bg-orange-600 text-white! p-2 rounded-full mb-3 mx-auto flex items-center justify-center">
                                        MD
                                    </span>
                                </div>
                                <div>
                                    <span class="font-semibold">Mr Danso</span>
                                </div>
                                <div class="text-sm">Google Review</div>
                            </footer>
                        </article>

                        <article class="review-card">
                            <div class="review-stars">
                                <FiveStars />
                            </div>
                            <blockquote>
                                A wonderful way to experience rural Ghana. The
                                surroundings were beautiful and there was so
                                much to discover.
                            </blockquote>
                            <footer class="text-center">
                                <div>
                                    <span class="w-12 h-12 bg-orange-600 text-white! p-2 rounded-full mb-3 mx-auto flex items-center justify-center">
                                        MO
                                    </span>
                                </div>
                                <div>
                                    <span class="font-semibold">Mavis Oti</span>
                                </div>
                                <div class="text-sm">Google Review</div>
                            </footer>
                        </article>

                        <article class="review-card">
                            <span class="review-card-number">04</span>

                            <div class="review-stars">
                                <FiveStars />
                            </div>

                            <blockquote>
                                We came looking for somewhere peaceful and ended
                                up with an experience we will remember for a
                                long time.
                            </blockquote>

                            <footer class="text-center">
                                <div>
                                    <span class="w-12 h-12 bg-orange-600 text-white! p-2 rounded-full mb-3 mx-auto flex items-center justify-center">
                                        KA
                                    </span>
                                </div>
                                <div>
                                    <span class="font-semibold">
                                        Kwame Adoko
                                    </span>
                                </div>
                                <div class="text-sm">Google Review</div>
                            </footer>
                        </article>

                        <article class="review-card review-card-dark">
                            <div class="review-stars">
                                <FiveStars />
                            </div>

                            <blockquote>
                                Beautiful surroundings, friendly people, and a
                                completely different pace of life. Exactly what
                                we needed.
                            </blockquote>

                            <footer class="text-center">
                                <div>
                                    <span class="w-12 h-12 bg-orange-600 text-white! p-2 rounded-full mb-3 mx-auto flex items-center justify-center">
                                        RA
                                    </span>
                                </div>
                                <div>
                                    <span class="font-semibold">
                                        Rita Abban
                                    </span>
                                </div>
                                <div class="text-sm">Google Review</div>
                            </footer>
                        </article>

                        <article class="review-card">
                            <div class="review-stars">
                                <FiveStars />
                            </div>

                            <blockquote>
                                One of those places where you leave feeling like
                                you have actually experienced somewhere rather
                                than simply visited it.
                            </blockquote>

                            <footer class="text-center">
                                <div>
                                    <span class="w-12 h-12 bg-orange-600 text-white! p-2 rounded-full mb-3 mx-auto flex items-center justify-center">
                                        JMJ
                                    </span>
                                </div>
                                <div>
                                    <span class="font-semibold">
                                        Jon Madison John
                                    </span>
                                </div>
                                <div class="text-sm">Google Review</div>
                            </footer>
                        </article>
                    </div>

                    <div class="mt-32 flex justify-center">
                        <button class="px-5 py-2 rounded-full flex items-center gap-2 cursor-pointer">
                            <span>Load more</span>
                            <span>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="1.5"
                                    stroke="currentColor"
                                    class="size-6"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"
                                    />
                                </svg>
                            </span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Review Quote -->
            <!-- <section class="review-statement">
                <div class="reviews-container">
                    <div class="review-statement-content">
                        <span>“</span>

                        <h2>Come for the experience. Leave with a story.</h2>
                    </div>
                </div>
            </section> -->

            <!-- CTA -->
            <!-- DATA -->
        </main>

        <style>
            .reviews-page {
                background: #f4f1e8;
                color: #263b2a;
            }

            .reviews-container {
                width: min(1200px, calc(100% - 48px));
                margin: 0 auto;
            }

            /* Hero */

            .reviews-hero {
                padding: 150px 0 120px;
            }

            .reviews-hero-content {
                max-width: 850px;
            }

            .reviews-eyebrow,
            .reviews-label,
            .reviews-section-heading p,
            .reviews-cta-content > p {
                margin: 0;
                color: #66705f;
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .reviews-hero h1 {
                margin: 24px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(52px, 8vw, 96px);
                font-weight: 300;
                line-height: 0.95;
                letter-spacing: -0.05em;
            }

            .reviews-hero-content > p:last-child {
                max-width: 650px;
                margin: 36px 0 0;
                color: #66705f;
                font-size: 18px;
                line-height: 1.7;
            }

            /* Intro */

            .reviews-intro {
                padding: 110px 0;
                background: #fff;
            }

            .reviews-intro-grid {
                display: grid;
                grid-template-columns: 180px 1fr;
                gap: 80px;
            }

            .reviews-number {
                color: #66705f;
                font-size: 14px;
            }

            .reviews-intro h2 {
                max-width: 800px;
                margin: 18px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(38px, 5vw, 64px);
                font-weight: 300;
                line-height: 1.05;
                letter-spacing: -0.04em;
            }

            .reviews-intro-text {
                max-width: 650px;
                margin: 32px 0 0;
                color: #66705f;
                font-size: 17px;
                line-height: 1.8;
            }

            /* Featured */

            .featured-review {
                padding: 110px 0;
                background: #fff;
            }

            .featured-review-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                min-height: 600px;
            }

            .featured-review-image {
                min-height: 500px;
                overflow: hidden;
            }

            .featured-review-image img {
                width: 100%;
                height: 100%;
                display: block;
                object-fit: cover;
            }

            .featured-review-content {
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 70px;
                background: #263b2a;
                color: white;
            }

            .quote-mark {
                font-family: Georgia, serif;
                font-size: 90px;
                font-weight: 300;
                line-height: 0.6;
                color: rgba(255, 255, 255, 0.35);
            }

            .featured-review blockquote {
                max-width: 540px;
                margin: 40px 0 50px;
                font-family: Georgia, serif;
                font-size: clamp(27px, 3vw, 42px);
                font-weight: 300;
                line-height: 1.25;
                letter-spacing: -0.025em;
            }

            .review-author {
                display: flex;
                flex-direction: column;
                gap: 5px;
            }

            .review-author strong {
                font-size: 14px;
                font-weight: 500;
            }

            .review-author span {
                color: rgba(255, 255, 255, 0.5);
                font-size: 13px;
            }

            /* Reviews */

            .reviews-list {
                padding: 120px 0;
            }

            .reviews-section-heading {
                margin-bottom: 55px;
            }

            .reviews-section-heading h2 {
                margin: 18px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(40px, 5vw, 62px);
                font-weight: 300;
                line-height: 1;
                letter-spacing: -0.04em;
            }

            .reviews-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }

            .review-card {
                border-radius: 30px;
                position: relative;
                min-height: 390px;
                padding: 38px;
                display: flex;
                flex-direction: column;
                background: white;
            }

            .review-card-dark {
                background-color: #252525;
                color: white;
            }

            .review-card-number {
                color: #66705f;
                font-size: 13px;
            }

            .review-card-dark .review-card-number {
                color: rgba(255, 255, 255, 0.5);
            }

            .review-stars {
                margin-top: 45px;
                font-size: 13px;
                letter-spacing: 0.15em;
            }

            .review-card blockquote {
                max-width: 550px;
                margin: 22px 0 40px;
                font-family: Georgia, serif;
                font-size: 24px;
                font-weight: 300;
                line-height: 1.45;
            }

            .review-card footer {
                display: flex;
                flex-direction: column;
                gap: 5px;
                margin-top: auto;
            }

            .review-card footer strong {
                font-size: 13px;
                font-weight: 500;
            }

            .review-card footer span {
                color: #66705f;
                font-size: 13px;
            }

            .review-card-dark footer span {
                color: rgba(255, 255, 255, 0.5);
            }

            /* Statement */

            .review-statement {
                padding: 150px 0;
                background: #fff;
            }

            .review-statement-content {
                max-width: 900px;
                margin: 0 auto;
                text-align: center;
            }

            .review-statement-content > span {
                display: block;
                font-family: Georgia, serif;
                font-size: 90px;
                line-height: 0.6;
                color: #66705f;
            }

            .review-statement h2 {
                margin: 50px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(42px, 6vw, 72px);
                font-weight: 300;
                line-height: 1.05;
                letter-spacing: -0.045em;
            }

            /* CTA */

            .reviews-cta {
                padding: 120px 0;
                background: #263b2a;
                color: white;
            }

            .reviews-cta-content {
                max-width: 850px;
            }

            .reviews-cta-content > p {
                color: rgba(255, 255, 255, 0.5);
            }

            .reviews-cta h2 {
                margin: 22px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(52px, 7vw, 90px);
                font-weight: 300;
                line-height: 0.95;
                letter-spacing: -0.05em;
            }

            .reviews-cta a {
                display: inline-flex;
                align-items: center;
                gap: 16px;
                margin-top: 42px;
                padding: 14px 22px;
                border-radius: 999px;
                background: white;
                color: #263b2a;
                font-size: 14px;
                font-weight: 500;
                text-decoration: none;
            }

            .reviews-cta a span {
                font-size: 18px;
            }

            /* Responsive */

            @media (max-width: 900px) {
                .reviews-intro-grid {
                    grid-template-columns: 1fr;
                    gap: 35px;
                }

                .featured-review-grid {
                    grid-template-columns: 1fr;
                }

                .featured-review-image {
                    min-height: 420px;
                }

                .featured-review-content {
                    padding: 55px 40px;
                }

                .reviews-grid {
                    grid-template-columns: 1fr;
                }
            }

            @media (max-width: 640px) {
                .reviews-container {
                    width: calc(100% - 32px);
                }

                .reviews-hero {
                    padding: 110px 0 80px;
                }

                .reviews-intro,
                .featured-review,
                .reviews-list {
                    padding: 80px 0;
                }

                .featured-review-image {
                    min-height: 330px;
                }

                .featured-review-content {
                    padding: 50px 28px;
                }

                .review-card {
                    min-height: 350px;
                    padding: 30px;
                }

                .review-statement {
                    padding: 100px 0;
                }

                .reviews-cta {
                    padding: 90px 0;
                }
            }
        </style>
    </Page>
</Layout>
