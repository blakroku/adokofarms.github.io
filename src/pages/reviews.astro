---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";

const title = "Reviews";
---

<Layout>
    <Page title="Reviews">
        <main class="reviews-page">
            <!-- Hero -->
            <section class="reviews-hero">
                <div class="reviews-container">
                    <div class="reviews-hero-content">
                        <p class="reviews-eyebrow">Guest reviews</p>

                        <h1>
                            Stories from
                            <br />
                            our guests.
                        </h1>

                        <p>
                            Hear from the people who have stayed with us,
                            explored the farm, joined our experiences, and
                            discovered a different side of Ghana.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Introduction -->
            <section class="reviews-intro">
                <div class="reviews-container">
                    <div class="reviews-intro-grid">
                        <div>
                            <span class="reviews-number">01</span>
                        </div>

                        <div>
                            <p class="reviews-label">What guests say</p>

                            <h2>
                                More than a place to visit. A place to remember.
                            </h2>

                            <p class="reviews-intro-text">
                                Every visit is different. Some guests come for
                                the countryside, others for the food, the farm,
                                the experiences, or simply a chance to slow
                                down. Here are some of their stories.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Featured Review -->
            <section class="featured-review">
                <div class="reviews-container">
                    <div class="featured-review-grid">
                        <div class="featured-review-image">
                            <img
                                src="https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1400&q=85"
                                alt="Guests enjoying a countryside experience"
                            />
                        </div>

                        <div class="featured-review-content">
                            <span class="quote-mark">“</span>

                            <blockquote>
                                “A beautiful escape from the usual tourist
                                experience. The atmosphere, the surroundings,
                                and the whole experience made us feel like we
                                were seeing a different side of Ghana.”
                            </blockquote>

                            <div class="review-author">
                                <strong>Guest review</strong>
                                <span>Ghana</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Reviews Grid -->
            <section class="reviews-list">
                <div class="reviews-container">
                    <div class="reviews-section-heading">
                        <p>From our guests</p>
                        <h2>Experiences worth sharing.</h2>
                    </div>

                    <div class="reviews-grid">
                        <article class="review-card">
                            <span class="review-card-number">01</span>

                            <div class="review-stars">★★★★★</div>

                            <blockquote>
                                “The perfect place to get away from the city. We
                                loved the peaceful surroundings and the
                                opportunity to spend time in nature.”
                            </blockquote>

                            <footer>
                                <strong>Guest review</strong>
                                <span>Accra, Ghana</span>
                            </footer>
                        </article>

                        <article class="review-card review-card-dark">
                            <span class="review-card-number">02</span>

                            <div class="review-stars">★★★★★</div>

                            <blockquote>
                                “It felt completely different from a normal
                                hotel stay. The farm environment and the slower
                                pace made the experience really memorable.”
                            </blockquote>

                            <footer>
                                <strong>Guest review</strong>
                                <span>Ghana</span>
                            </footer>
                        </article>

                        <article class="review-card">
                            <span class="review-card-number">03</span>

                            <div class="review-stars">★★★★★</div>

                            <blockquote>
                                “A wonderful way to experience rural Ghana. The
                                surroundings were beautiful and there was so
                                much to discover.”
                            </blockquote>

                            <footer>
                                <strong>Guest review</strong>
                                <span>International guest</span>
                            </footer>
                        </article>

                        <article class="review-card">
                            <span class="review-card-number">04</span>

                            <div class="review-stars">★★★★★</div>

                            <blockquote>
                                “We came looking for somewhere peaceful and
                                ended up with an experience we will remember for
                                a long time.”
                            </blockquote>

                            <footer>
                                <strong>Guest review</strong>
                                <span>Accra, Ghana</span>
                            </footer>
                        </article>

                        <article class="review-card review-card-dark">
                            <span class="review-card-number">05</span>

                            <div class="review-stars">★★★★★</div>

                            <blockquote>
                                “Beautiful surroundings, friendly people, and a
                                completely different pace of life. Exactly what
                                we needed.”
                            </blockquote>

                            <footer>
                                <strong>Guest review</strong>
                                <span>International guest</span>
                            </footer>
                        </article>

                        <article class="review-card">
                            <span class="review-card-number">06</span>

                            <div class="review-stars">★★★★★</div>

                            <blockquote>
                                “One of those places where you leave feeling
                                like you have actually experienced somewhere
                                rather than simply visited it.”
                            </blockquote>

                            <footer>
                                <strong>Guest review</strong>
                                <span>Ghana</span>
                            </footer>
                        </article>
                    </div>
                </div>
            </section>

            <!-- Review Quote -->
            <section class="review-statement">
                <div class="reviews-container">
                    <div class="review-statement-content">
                        <span>“</span>

                        <h2>Come for the experience. Leave with a story.</h2>
                    </div>
                </div>
            </section>

            <!-- CTA -->
            <section class="reviews-cta">
                <div class="reviews-container">
                    <div class="reviews-cta-content">
                        <p>Ready to experience it yourself?</p>

                        <h2>
                            Your story could
                            <br />
                            be next.
                        </h2>

                        <a href="/contact">
                            Plan your visit
                            <span>→</span>
                        </a>
                    </div>
                </div>
            </section>
        </main>

        <style>
            .reviews-page {
                background: #f4f1e8;
                color: #263b2a;
            }

            .reviews-container {
                width: min(1200px, calc(100% - 48px));
                margin: 0 auto;
            }

            /* Hero */

            .reviews-hero {
                padding: 150px 0 120px;
            }

            .reviews-hero-content {
                max-width: 850px;
            }

            .reviews-eyebrow,
            .reviews-label,
            .reviews-section-heading p,
            .reviews-cta-content > p {
                margin: 0;
                color: #66705f;
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .reviews-hero h1 {
                margin: 24px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(52px, 8vw, 96px);
                font-weight: 300;
                line-height: 0.95;
                letter-spacing: -0.05em;
            }

            .reviews-hero-content > p:last-child {
                max-width: 650px;
                margin: 36px 0 0;
                color: #66705f;
                font-size: 18px;
                line-height: 1.7;
            }

            /* Intro */

            .reviews-intro {
                padding: 110px 0;
                background: #fff;
            }

            .reviews-intro-grid {
                display: grid;
                grid-template-columns: 180px 1fr;
                gap: 80px;
            }

            .reviews-number {
                color: #66705f;
                font-size: 14px;
            }

            .reviews-intro h2 {
                max-width: 800px;
                margin: 18px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(38px, 5vw, 64px);
                font-weight: 300;
                line-height: 1.05;
                letter-spacing: -0.04em;
            }

            .reviews-intro-text {
                max-width: 650px;
                margin: 32px 0 0;
                color: #66705f;
                font-size: 17px;
                line-height: 1.8;
            }

            /* Featured */

            .featured-review {
                padding: 110px 0;
                background: #fff;
            }

            .featured-review-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                min-height: 600px;
            }

            .featured-review-image {
                min-height: 500px;
                overflow: hidden;
            }

            .featured-review-image img {
                width: 100%;
                height: 100%;
                display: block;
                object-fit: cover;
            }

            .featured-review-content {
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 70px;
                background: #263b2a;
                color: white;
            }

            .quote-mark {
                font-family: Georgia, serif;
                font-size: 90px;
                font-weight: 300;
                line-height: 0.6;
                color: rgba(255, 255, 255, 0.35);
            }

            .featured-review blockquote {
                max-width: 540px;
                margin: 40px 0 50px;
                font-family: Georgia, serif;
                font-size: clamp(27px, 3vw, 42px);
                font-weight: 300;
                line-height: 1.25;
                letter-spacing: -0.025em;
            }

            .review-author {
                display: flex;
                flex-direction: column;
                gap: 5px;
            }

            .review-author strong {
                font-size: 14px;
                font-weight: 500;
            }

            .review-author span {
                color: rgba(255, 255, 255, 0.5);
                font-size: 13px;
            }

            /* Reviews */

            .reviews-list {
                padding: 120px 0;
            }

            .reviews-section-heading {
                margin-bottom: 55px;
            }

            .reviews-section-heading h2 {
                margin: 18px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(40px, 5vw, 62px);
                font-weight: 300;
                line-height: 1;
                letter-spacing: -0.04em;
            }

            .reviews-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }

            .review-card {
                position: relative;
                min-height: 390px;
                padding: 38px;
                display: flex;
                flex-direction: column;
                background: white;
            }

            .review-card-dark {
                background: #66705f;
                color: white;
            }

            .review-card-number {
                color: #66705f;
                font-size: 13px;
            }

            .review-card-dark .review-card-number {
                color: rgba(255, 255, 255, 0.5);
            }

            .review-stars {
                margin-top: 45px;
                font-size: 13px;
                letter-spacing: 0.15em;
            }

            .review-card blockquote {
                max-width: 550px;
                margin: 22px 0 40px;
                font-family: Georgia, serif;
                font-size: 24px;
                font-weight: 300;
                line-height: 1.45;
            }

            .review-card footer {
                display: flex;
                flex-direction: column;
                gap: 5px;
                margin-top: auto;
            }

            .review-card footer strong {
                font-size: 13px;
                font-weight: 500;
            }

            .review-card footer span {
                color: #66705f;
                font-size: 13px;
            }

            .review-card-dark footer span {
                color: rgba(255, 255, 255, 0.5);
            }

            /* Statement */

            .review-statement {
                padding: 150px 0;
                background: #fff;
            }

            .review-statement-content {
                max-width: 900px;
                margin: 0 auto;
                text-align: center;
            }

            .review-statement-content > span {
                display: block;
                font-family: Georgia, serif;
                font-size: 90px;
                line-height: 0.6;
                color: #66705f;
            }

            .review-statement h2 {
                margin: 50px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(42px, 6vw, 72px);
                font-weight: 300;
                line-height: 1.05;
                letter-spacing: -0.045em;
            }

            /* CTA */

            .reviews-cta {
                padding: 120px 0;
                background: #263b2a;
                color: white;
            }

            .reviews-cta-content {
                max-width: 850px;
            }

            .reviews-cta-content > p {
                color: rgba(255, 255, 255, 0.5);
            }

            .reviews-cta h2 {
                margin: 22px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(52px, 7vw, 90px);
                font-weight: 300;
                line-height: 0.95;
                letter-spacing: -0.05em;
            }

            .reviews-cta a {
                display: inline-flex;
                align-items: center;
                gap: 16px;
                margin-top: 42px;
                padding: 14px 22px;
                border-radius: 999px;
                background: white;
                color: #263b2a;
                font-size: 14px;
                font-weight: 500;
                text-decoration: none;
            }

            .reviews-cta a span {
                font-size: 18px;
            }

            /* Responsive */

            @media (max-width: 900px) {
                .reviews-intro-grid {
                    grid-template-columns: 1fr;
                    gap: 35px;
                }

                .featured-review-grid {
                    grid-template-columns: 1fr;
                }

                .featured-review-image {
                    min-height: 420px;
                }

                .featured-review-content {
                    padding: 55px 40px;
                }

                .reviews-grid {
                    grid-template-columns: 1fr;
                }
            }

            @media (max-width: 640px) {
                .reviews-container {
                    width: calc(100% - 32px);
                }

                .reviews-hero {
                    padding: 110px 0 80px;
                }

                .reviews-intro,
                .featured-review,
                .reviews-list {
                    padding: 80px 0;
                }

                .featured-review-image {
                    min-height: 330px;
                }

                .featured-review-content {
                    padding: 50px 28px;
                }

                .review-card {
                    min-height: 350px;
                    padding: 30px;
                }

                .review-statement {
                    padding: 100px 0;
                }

                .reviews-cta {
                    padding: 90px 0;
                }
            }
        </style>
    </Page>
</Layout>
