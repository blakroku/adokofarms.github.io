---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";

const title = "About us";
---

<Layout title={title}>
    <Page>
        <section class="container mx-auto">
            <header class="text-center py-32 bg-[#F4F1E8]">
                <div>
                    <div>
                        <span class="text-sm uppercase tracking-widest">
                            Adoko Farms
                        </span>
                    </div>
                    <div class="pb-5">
                        <span class="text-4xl md:text-5xl font-black flex flex-col gap-2 tracking-wide px-4 md:px-0">
                            <span>A different way to</span>
                            <span>experience Ghana</span>
                        </span>
                    </div>
                    <span class="w-10 h-1.5 rounded-full bg-[#F54A00] inline-block"></span>
                </div>
            </header>

            <section class="bg-white px-4 py-12 md:p-32 rounded-b-3xl w-full md:container md:mx-auto">
                <h3 class="font-black text-4xl mb-6">
                    Turning Every Journey into an Everlasting Memory
                </h3>
                <div class="space-y-6">
                    <p>
                        Adoko Farms is a working farm and agrotourism
                        destination in Akropong-Akuapem, about 54km from Accra.
                        We create experiences that bring people closer to
                        nature, farming, local communities, and the quieter side
                        of Ghana. From spending a night at the farm to exploring
                        the surrounding landscape, our experiences are designed
                        around discovering Ghana beyond the usual tourist paths.
                    </p>
                    <p>
                        Founded with a passion for travel, Adoko Farms has grown
                        to become a name in the eco tourism industry. You have
                        the option to customise your journey with us because
                        where you travel is always your choice. We assure you
                        safety, security and a happy adventure. With over 10000
                        guests visits, our journey itself is the story that
                        inspires people to visit us.
                    </p>
                </div>
                <div class="mt-9">
                    <h3 class="font-black text-4xl mb-6">What we offer:</h3>
                    <div class="space-y-6">
                        <p>
                            We believe travel becomes more meaningful when you
                            have the opportunity to slow down and experience a
                            place beyond its most obvious attractions. That's
                            why Adoko Farms brings together accommodation, food,
                            farming, nature, and experiences in one place.
                        </p>
                        <p>
                            Our goal is simple: create experiences that help
                            guests discover another side of Ghana.
                        </p>
                        <p>
                            <ul class="space-y-2">
                                <li>Over 10,000+ guests</li>
                                <li>300+ tours experienced</li>
                                <li>6 years of existence</li>
                            </ul>
                        </p>
                        <p class="font-semibold text-2xl brush-font mt-14">
                            There is another side of Ghana beyond the busy
                            cities and familiar tourist destinations. It is
                            found in rural landscapes, farms, communities, food,
                            nature, and the everyday experiences that make our
                            place memorable.
                        </p>
                    </div>
                </div>
            </section>
            <div class="w-full md:container mx-auto flex justify-end mt-3 px-4">
                <a class="flex items-center gap-2" href="/">
                    <span>Back to Home</span>
                    <span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.2"
                            stroke="currentColor"
                            class="size-6"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"
                            />
                        </svg>
                    </span>
                </a>
            </div>
        </section>
    </Page>
</Layout>
