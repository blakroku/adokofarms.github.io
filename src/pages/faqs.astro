---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";
import Hero from "../components/Hero.astro";
---

<Layout title="Frequently Asked Questions">
    <Page title="FAQs">
        <!-- <Hero
            heroTitle="Frequently asked questions"
            firstHeroTitle="What you need to"
            secondHeroTitle="know before visiting"
        /> -->
        <header>
            <div class="text-center py-20">
                <div class="flex justify-center mb-3">
                    <div class="border-2 text-[#322E28] font-semibold border-[#322E28] inline-flex justify-center px-5 py-2 rounded-full text-sm tracking-widest uppercase">
                        FAQ's
                    </div>
                </div>
                <p class="text-7xl flex flex-col hero-font-style">
                    <span>What you need to know</span>
                    <span>before visiting.</span>
                </p>
                <div class="w-full sm:w-100 px-4 sm:px-0 mx-auto mt-22">
                    <div class="flex flex-wrap gap-3 align-center justify-center">
                        <a
                            href="#stays"
                            class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer"
                        >
                            Stays &amp; Accommodations
                        </a>
                        <a
                            href="#activities"
                            class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer"
                        >
                            Activities &amp; Experience
                        </a>
                        <a
                            href="#tours"
                            class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer"
                        >
                            Tours
                        </a>
                        <a
                            href="#booking"
                            class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer"
                        >
                            Booking &amp; Payments
                        </a>
                        <a
                            href="#getting-here"
                            class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer"
                        >
                            Getting Here
                        </a>
                        <a
                            href="#food"
                            class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer text-white!"
                        >
                            Food & Dining
                        </a>
                        <a
                            href="#before-visit"
                            class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer text-white!"
                        >
                            Before You Visit
                        </a>
                    </div>
                </div>
                <!-- <div class="w-full sm:w-100 px-4 sm:px-0 mx-auto mt-12">
                    <form role="form">
                        <input
                            class="border rounded-full px-6 py-3"
                            type="search"
                            placeholder="search..."
                        />
                    </form>
                </div> -->
            </div>
        </header>
        <main class="faq-page">
            <section class="faq-content">
                <div class="faq-container">
                    <div class="faq-lasyout">
                        <!-- <aside class="faq-sidebar hidden sm:block">
                            <nav>
                                <a class="btn text-white!" href="#stays">
                                    Stays & Accommodation
                                </a>
                                <a class="btn text-white!" href="#activities">
                                    Activities & Experiences
                                </a>
                                <a class="btn text-white!" href="#tours">
                                    Tours
                                </a>
                                <a class="btn text-white!" href="#booking">
                                    Booking & Payments
                                </a>
                                <a class="btn text-white!" href="#getting-here">
                                    Getting Here
                                </a>
                                <a class="btn text-white!" href="#food">
                                    Food & Dining
                                </a>
                                <a class="btn text-white!" href="#before-visit">
                                    Before Your Visit
                                </a>
                            </nav>
                        </aside> -->

                        <div class="faq-list">
                            <section class="faq-category" id="stays">
                                <div class="faq-category-heading">
                                    <h3 class="header-level-3 text-xl! uppercase tracking-wide">
                                        Stays & Accommodation
                                    </h3>
                                </div>

                                <div class="space-y-4">
                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                What types of accommodation do
                                                you offer?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            We offer accommodation designed for
                                            guests who want to slow down, enjoy
                                            nature, and experience a quieter
                                            side of Ghana.
                                        </div>
                                    </div>

                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Can I stay at Adoko Farms for
                                                one night?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Yes, depending on availability and
                                            the minimum stay requirements for
                                            the accommodation you choose.
                                        </div>
                                    </div>

                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Is Adoko Farms suitable for
                                                families?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Yes. Our farm and surrounding area
                                            offer experiences that can be
                                            enjoyed by families, couples,
                                            groups, and individual travellers.
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="faq-category" id="activities">
                                <div class="faq-category-heading">
                                    <h3 class="header-level-3 text-4xl!">
                                        Activities & Experiences
                                    </h3>
                                </div>

                                <div class="space-y-4">
                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                What activities can I do at
                                                Adoko Farms?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Our experiences include farm
                                            activities, nature experiences,
                                            guided tours, outdoor adventures,
                                            and other ways to explore the
                                            surrounding area.
                                        </div>
                                    </div>

                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Do I need to book activities in
                                                advance?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            We recommend booking in advance so
                                            we can prepare for your visit and
                                            confirm availability.
                                        </div>
                                    </div>

                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Are activities suitable for
                                                children?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Some activities are suitable for
                                            children, while others may have age
                                            or other requirements. Check the
                                            individual activity details before
                                            booking.
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="faq-category" id="tours">
                                <div class="faq-category-heading">
                                    <h3 class="header-level-3 text-4xl!">
                                        Tours
                                    </h3>
                                </div>

                                <div class="space-y-4">
                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                What is the difference between a
                                                tour and an activity?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            An activity is an individual
                                            experience you can enjoy at or
                                            around Adoko Farms. A tour is a
                                            planned journey with its own
                                            schedule, itinerary, and booking
                                            details.
                                        </div>
                                    </div>

                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Can I book an upcoming tour?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Yes. Upcoming tours are listed on
                                            our Tours page with their dates,
                                            details, and booking options.
                                        </div>
                                    </div>
                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Can I view tours that have
                                                already happened?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Yes. Past tours are kept as part of
                                            our travel journal, allowing you to
                                            explore previous journeys.
                                        </div>
                                    </div>

                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Can I book a past tour?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            No. Past tours are historical
                                            journeys and are available to view
                                            rather than book.
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="faq-category" id="booking">
                                <div class="faq-category-heading">
                                    <h3 class="header-level-3 text-4xl!">
                                        Booking & Payments
                                    </h3>
                                </div>

                                <div class="space-y-4">
                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                How do I make a booking?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Choose the experience,
                                            accommodation, or tour you are
                                            interested in and follow the booking
                                            instructions provided on the
                                            relevant page.
                                        </div>
                                    </div>

                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Do I need to book in advance?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Advance booking is recommended,
                                            particularly for accommodation,
                                            guided experiences, and scheduled
                                            tours.
                                        </div>
                                    </div>

                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Can I make a group booking?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Yes. For larger groups, contact us
                                            directly so we can discuss
                                            availability and arrangements.
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="faq-category" id="getting-here">
                                <div class="faq-category-heading">
                                    <h3 class="header-level-3 text-4xl!">
                                        Getting Here
                                    </h3>
                                </div>

                                <div class="space-y-4">
                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Where is Adoko Farms located?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Adoko Farms is located in
                                            Akropong-Akuapem, Ghana, surrounded
                                            by the landscape of rural Ghana.
                                        </div>
                                    </div>

                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                How do I get to Adoko Farms?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            You can find directions and travel
                                            information on our Directions page.
                                        </div>
                                    </div>

                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Can I come from Accra for a day
                                                visit?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Yes. Adoko Farms can be visited as
                                            part of a day trip from Accra,
                                            depending on the experience you
                                            choose.
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="faq-category" id="food">
                                <div class="faq-category-heading">
                                    <h3 class="header-level-3 text-4xl!">
                                        Food & Dining
                                    </h3>
                                </div>

                                <div class="space-y-4">
                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                Do you offer food or dining
                                                experiences?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
                                            x-show="open"
                                        >
                                            Yes. Food is part of the experience
                                            at Adoko Farms, with farm-to-table
                                            and local dining experiences
                                            available depending on the visit.
                                        </div>
                                    </div>

                                    <div
                                        class="rounded-2xl px-8 py-6 bg-[#F9F8F1] border border-gray-500"
                                        x-data="{ open: false }"
                                    >
                                        <div
                                            class="flex justify-between cursor-pointer"
                                            @click="open = !open"
                                        >
                                            <h3 class="font-semibold text-xl">
                                                CCan you accommodate dietary
                                                requirements?
                                            </h3>
                                            <span>
                                                <span x-show="!open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 font-bold text-3xl"></i>
                                                </span>
                                                <span x-show="open">
                                                    <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-01 font-bold text-3xl"></i>
                                                </span>
                                            </span>
                                        </div>

                                        <div
                                            class="faqs-content mt-6"
