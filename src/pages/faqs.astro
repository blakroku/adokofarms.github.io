---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";

const title = "Frequently Asked Questions";
---

<Layout title={title}>
    <Page title="FAQs">
        <main class="faq-page">
            <section class="faq-hero">
                <div class="faq-container">
                    <div class="faq-hero-content">
                        <p class="faq-eyebrow">Frequently asked questions</p>

                        <h1>
                            Everything you need
                            <br />
                            to know before you visit.
                        </h1>

                        <p class="faq-intro">
                            Find answers about staying with us, activities,
                            tours, bookings, getting here, and what to expect at
                            Adoko Farms.
                        </p>
                    </div>
                </div>
            </section>

            <section class="faq-content">
                <div class="faq-container">
                    <div class="faq-layout">
                        <aside class="faq-sidebar">
                            <p class="faq-sidebar-title">Categories</p>

                            <nav>
                                <a href="#stays">Stays & Accommodation</a>
                                <a href="#activities">
                                    Activities & Experiences
                                </a>
                                <a href="#tours">Tours</a>
                                <a href="#booking">Booking & Payments</a>
                                <a href="#getting-here">Getting Here</a>
                                <a href="#food">Food & Dining</a>
                                <a href="#before-visit">Before Your Visit</a>
                            </nav>
                        </aside>

                        <div class="faq-list">
                            <section class="faq-category" id="stays">
                                <div class="faq-category-heading">
                                    <span>01</span>
                                    <h2>Stays & Accommodation</h2>
                                </div>

                                <div class="faq-items">
                                    <div class="faq-item">
                                        <h3>
                                            What types of accommodation do you
                                            offer?
                                        </h3>
                                        <p>
                                            We offer accommodation designed for
                                            guests who want to slow down, enjoy
                                            nature, and experience a quieter
                                            side of Ghana.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>
                                            Can I stay at Adoko Farms for one
                                            night?
                                        </h3>
                                        <p>
                                            Yes, depending on availability and
                                            the minimum stay requirements for
                                            the accommodation you choose.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>
                                            Is Adoko Farms suitable for
                                            families?
                                        </h3>
                                        <p>
                                            Yes. Our farm and surrounding area
                                            offer experiences that can be
                                            enjoyed by families, couples,
                                            groups, and individual travellers.
                                        </p>
                                    </div>
                                </div>
                            </section>

                            <section class="faq-category" id="activities">
                                <div class="faq-category-heading">
                                    <span>02</span>
                                    <h2>Activities & Experiences</h2>
                                </div>

                                <div class="faq-items">
                                    <div class="faq-item">
                                        <h3>
                                            What activities can I do at Adoko
                                            Farms?
                                        </h3>
                                        <p>
                                            Our experiences include farm
                                            activities, nature experiences,
                                            guided tours, outdoor adventures,
                                            and other ways to explore the
                                            surrounding area.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>
                                            Do I need to book activities in
                                            advance?
                                        </h3>
                                        <p>
                                            We recommend booking in advance so
                                            we can prepare for your visit and
                                            confirm availability.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>
                                            Are activities suitable for
                                            children?
                                        </h3>
                                        <p>
                                            Some activities are suitable for
                                            children, while others may have age
                                            or other requirements. Check the
                                            individual activity details before
                                            booking.
                                        </p>
                                    </div>
                                </div>
                            </section>

                            <section class="faq-category" id="tours">
                                <div class="faq-category-heading">
                                    <span>03</span>
                                    <h2>Tours</h2>
                                </div>

                                <div class="faq-items">
                                    <div class="faq-item">
                                        <h3>
                                            What is the difference between a
                                            tour and an activity?
                                        </h3>
                                        <p>
                                            An activity is an individual
                                            experience you can enjoy at or
                                            around Adoko Farms. A tour is a
                                            planned journey with its own
                                            schedule, itinerary, and booking
                                            details.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>Can I book an upcoming tour?</h3>
                                        <p>
                                            Yes. Upcoming tours are listed on
                                            our Tours page with their dates,
                                            details, and booking options.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>
                                            Can I view tours that have already
                                            happened?
                                        </h3>
                                        <p>
                                            Yes. Past tours are kept as part of
                                            our travel journal, allowing you to
                                            explore previous journeys.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>Can I book a past tour?</h3>
                                        <p>
                                            No. Past tours are historical
                                            journeys and are available to view
                                            rather than book.
                                        </p>
                                    </div>
                                </div>
                            </section>

                            <section class="faq-category" id="booking">
                                <div class="faq-category-heading">
                                    <span>04</span>
                                    <h2>Booking & Payments</h2>
                                </div>

                                <div class="faq-items">
                                    <div class="faq-item">
                                        <h3>How do I make a booking?</h3>
                                        <p>
                                            Choose the experience,
                                            accommodation, or tour you are
                                            interested in and follow the booking
                                            instructions provided on the
                                            relevant page.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>Do I need to book in advance?</h3>
                                        <p>
                                            Advance booking is recommended,
                                            particularly for accommodation,
                                            guided experiences, and scheduled
                                            tours.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>Can I make a group booking?</h3>
                                        <p>
                                            Yes. For larger groups, contact us
                                            directly so we can discuss
                                            availability and arrangements.
                                        </p>
                                    </div>
                                </div>
                            </section>

                            <section class="faq-category" id="getting-here">
                                <div class="faq-category-heading">
                                    <span>05</span>
                                    <h2>Getting Here</h2>
                                </div>

                                <div class="faq-items">
                                    <div class="faq-item">
                                        <h3>Where is Adoko Farms located?</h3>
                                        <p>
                                            Adoko Farms is located in
                                            Akropong-Akuapem, Ghana, surrounded
                                            by the landscape of rural Ghana.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>How do I get to Adoko Farms?</h3>
                                        <p>
                                            You can find directions and travel
                                            information on our Directions page.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>
                                            Can I come from Accra for a day
                                            visit?
                                        </h3>
                                        <p>
                                            Yes. Adoko Farms can be visited as
                                            part of a day trip from Accra,
                                            depending on the experience you
                                            choose.
                                        </p>
                                    </div>
                                </div>
                            </section>

                            <section class="faq-category" id="food">
                                <div class="faq-category-heading">
                                    <span>06</span>
                                    <h2>Food & Dining</h2>
                                </div>

                                <div class="faq-items">
                                    <div class="faq-item">
                                        <h3>
                                            Do you offer food or dining
                                            experiences?
                                        </h3>
                                        <p>
                                            Yes. Food is part of the experience
                                            at Adoko Farms, with farm-to-table
                                            and local dining experiences
                                            available depending on the visit.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>
                                            Can you accommodate dietary
                                            requirements?
                                        </h3>
                                        <p>
                                            Let us know about any dietary
                                            requirements when making your
                                            booking so we can discuss what can
                                            be accommodated.
                                        </p>
                                    </div>
                                </div>
                            </section>

                            <section class="faq-category" id="before-visit">
                                <div class="faq-category-heading">
                                    <span>07</span>
                                    <h2>Before Your Visit</h2>
                                </div>

                                <div class="faq-items">
                                    <div class="faq-item">
                                        <h3>What should I wear?</h3>
                                        <p>
                                            Comfortable clothing and suitable
                                            footwear are recommended. Some
                                            experiences take place outdoors, so
                                            dress appropriately for walking and
                                            changing weather conditions.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>What happens if it rains?</h3>
                                        <p>
                                            Some outdoor experiences may be
                                            affected by weather conditions. If
                                            conditions require a change to your
                                            activity, we will advise you about
                                            the available options.
                                        </p>
                                    </div>

                                    <div class="faq-item">
                                        <h3>Can I bring a camera?</h3>
                                        <p>
                                            Absolutely. There are plenty of
                                            opportunities to photograph the
                                            landscape, farm, nature, and your
                                            experiences.
                                        </p>
                                    </div>
                                </div>
                            </section>
                        </div>
                    </div>
                </div>
            </section>

            <section class="faq-cta">
                <div class="faq-container">
                    <div class="faq-cta-content">
                        <p>Still have questions?</p>

                        <h2>We're happy to help.</h2>

                        <span>
                            If you can't find what you're looking for, get in
                            touch and we'll be happy to help you plan your
                            visit.
                        </span>

                        <a href="/contact">Contact us →</a>
                    </div>
                </div>
            </section>
        </main>

        <style>
            .faq-page {
                background: #f4f1e8;
                color: #263b2a;
            }

            .faq-container {
                width: min(1200px, calc(100% - 48px));
                margin: 0 auto;
            }

            .faq-hero {
                padding: 150px 0 110px;
            }

            .faq-hero-content {
                max-width: 760px;
            }

            .faq-eyebrow,
            .faq-sidebar-title {
                margin: 0;
                color: #66705f;
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .faq-hero h1 {
                margin: 24px 0 0;
                max-width: 850px;
                font-family: Georgia, serif;
                font-size: clamp(48px, 7vw, 88px);
                font-weight: 300;
                line-height: 0.98;
                letter-spacing: -0.045em;
            }

            .faq-intro {
                max-width: 650px;
                margin: 32px 0 0;
                color: #66705f;
                font-size: 18px;
                line-height: 1.7;
            }

            .faq-content {
                padding: 110px 0;
                background: #fff;
            }

            .faq-layout {
                display: grid;
                grid-template-columns: 220px minmax(0, 1fr);
                gap: 90px;
                align-items: start;
            }

            .faq-sidebar {
                position: sticky;
                top: 30px;
            }

            .faq-sidebar nav {
                display: flex;
                flex-direction: column;
                gap: 6px;
                margin-top: 24px;
            }

            .faq-sidebar a {
                padding: 10px 14px;
                border-radius: 999px;
                color: #66705f;
                font-size: 14px;
                line-height: 1.4;
                text-decoration: none;
                transition: 0.2s ease;
            }

            .faq-sidebar a:hover {
                background: #f4f1e8;
                color: #263b2a;
            }

            .faq-list {
                display: flex;
                flex-direction: column;
                gap: 110px;
            }

            .faq-category {
                scroll-margin-top: 30px;
            }

            .faq-category-heading {
                margin-bottom: 30px;
            }

            .faq-category-heading span {
                color: #66705f;
                font-size: 14px;
            }

            .faq-category-heading h2 {
                margin: 8px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(32px, 4vw, 48px);
                font-weight: 300;
                line-height: 1.1;
                letter-spacing: -0.03em;
            }

            .faq-items {
                border-top: 1px solid rgba(38, 59, 42, 0.12);
            }

            .faq-item {
                padding: 30px 0;
                border-bottom: 1px solid rgba(38, 59, 42, 0.12);
            }

            .faq-item h3 {
                margin: 0;
                font-size: 18px;
                font-weight: 500;
                line-height: 1.4;
            }

            .faq-item p {
                max-width: 720px;
                margin: 12px 0 0;
                color: #66705f;
                font-size: 16px;
                line-height: 1.8;
            }

            .faq-cta {
                padding: 110px 0;
                background: #263b2a;
                color: white;
            }

            .faq-cta-content {
                max-width: 720px;
            }

            .faq-cta p {
                margin: 0;
                color: rgba(255, 255, 255, 0.5);
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .faq-cta h2 {
                margin: 20px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(44px, 6vw, 72px);
                font-weight: 300;
                line-height: 1;
                letter-spacing: -0.04em;
            }

            .faq-cta span {
                display: block;
                max-width: 580px;
                margin-top: 25px;
                color: rgba(255, 255, 255, 0.65);
                font-size: 17px;
                line-height: 1.7;
            }

            .faq-cta a {
                display: inline-flex;
                margin-top: 32px;
                padding: 13px 22px;
                border-radius: 999px;
                background: white;
                color: #263b2a;
                font-size: 14px;
                font-weight: 500;
                text-decoration: none;
            }

            @media (max-width: 900px) {
                .faq-layout {
                    grid-template-columns: 1fr;
                    gap: 60px;
                }

                .faq-sidebar {
                    position: static;
                }

                .faq-sidebar nav {
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);
                    gap: 6px;
                }

                .faq-list {
                    gap: 80px;
                }
            }

            @media (max-width: 640px) {
                .faq-container {
                    width: min(100% - 32px, 1200px);
                }

                .faq-hero {
                    padding: 110px 0 80px;
                }

                .faq-content {
                    padding: 80px 0;
                }

                .faq-sidebar nav {
                    grid-template-columns: 1fr;
                }

                .faq-list {
                    gap: 70px;
                }

                .faq-item {
                    padding: 24px 0;
                }

                .faq-item h3 {
                    font-size: 16px;
                }

                .faq-item p {
                    font-size: 15px;
                }

                .faq-cta {
                    padding: 80px 0;
                }
            }
        </style>
    </Page>
</Layout>
