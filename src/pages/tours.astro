---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";
import Hero from "../components/Hero.astro";
---

<Layout title="Tours">
    <Page>
        <Hero
            heroTitle="Out tours"
            firstHeroTitle="What is"
            secondHeroTitle="happening?"
        />

        <!-- Upcoming Tours -->
        <section>
            <div class="container mx-auto sm:px-0">
                <!-- Upcoming Tours -->
                <section
                    class="py-12 sm:py-16 md:py-32"
                    x-data="{
                        current: 0,
                        total: 0,
                        next() {
                            if (this.current < this.total - 1) this.current++;
                        },
                        previous() {
                            if (this.current > 0) this.current--;
                        }
                    }"
                    x-init="total = $refs.experiences.children.length"
                >
                    <div class="container mx-auto px-4 sm:px-6">
                        <div class="bg-linear-to-br from-[#20905F] to-[#60B08A] p-5 sm:p-8 md:p-12 lg:p-20 xl:p-32 rounded-3xl md:rounded-4xl">
                            <div>
                                <h3 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-white/80">
                                    Our upcoming experience
                                </h3>
                            </div>

                            <main x-ref="experiences">
                                <!-- experience 1 -->
                                <div>
                                    <div
                                        class="flex flex-col md:flex-row justify-between gap-6 md:gap-8 mt-8 md:mt-12"
                                        x-show="current === 0"
                                    >
                                        <div class="w-full md:w-[50%] border p-5 sm:p-8 md:p-10 rounded-3xl tour-shadow-skin">
                                            <main class="space-y-6 md:space-y-9">
                                                <h3 class="font-semibold">
                                                    <a
                                                        href=""
                                                        class="hover:underline flex items-center justify-between"
                                                    >
                                                        <span class="text-2xl sm:text-2xl">
                                                            Campbuzz 6.0: The
                                                            wild experience
                                                        </span>
                                                        <span class="text-2xl sm:text-3xl">
                                                            <i class="hgi hgi-stroke hgi-rounded hgi-link-square-01"></i>
                                                        </span>
                                                    </a>
                                                </h3>
                                                <div class="text-wrap">
                                                    Full weekend get away. Two
                                                    nights. An unforgettable
                                                    camping adventure at Adoko
                                                    Farms Eco Resort. From quad
                                                    biking and sunrise hiking to
                                                    farm-to-table meals, bonfire
                                                    nights, movies under the
                                                    stars and new friendships,
                                                    this is your chance to step
                                                    away from the routine and
                                                    experience camping in Ghana
                                                    differently.
                                                </div>
                                            </main>
                                            <footer class="flex justify-between mt-12 items-center">
                                                <div>
                                                    <span class="flex gap-3 font-semibold text-xl">
                                                        <h4>From:</h4>
                                                        <span>GHC1,300.00</span>
                                                    </span>
                                                </div>
                                                <div class="flex gap-5 items-center">
                                                    <!-- <span>
                                                        <a
                                                            class="btn"
                                                            href="https://wa.me/2330579994032"
                                                        >
                                                            View experience
                                                        </a>
                                                    </span> -->
                                                    <span>
                                                        <a
                                                            class="btn"
                                                            href="https://wa.me/233535180741"
                                                            target="_blank"
                                                        >
                                                            Book now
                                                        </a>
                                                    </span>
                                                </div>
                                            </footer>
                                        </div>

                                        <div class="w-full md:w-[50%]">
                                            <img
                                                src="https://images.unsplash.com/photo-1780978670460-11340f303d0b?w=900&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
                                                alt="Upcoming tours"
                                                class="w-full h-64 sm:h-80 md:h-full object-cover rounded-3xl"
                                            />
                                        </div>
                                    </div>
                                </div>

                                <!-- experience 2 -->
                                <div>
                                    <div
                                        class="flex flex-col md:flex-row justify-between gap-6 md:gap-8 mt-8 md:mt-12"
                                        x-show="current === 1"
                                    >
                                        <div class="w-full md:w-[50%] border p-5 sm:p-8 md:p-10 rounded-3xl tour-shadow-skin">
                                            <main class="space-y-6 md:space-y-9">
                                                <h3 class="font-semibold">
                                                    <a
                                                        href=""
                                                        class="hover:underline flex items-center justify-between"
                                                    >
                                                        <span class="text-2xl sm:text-2xl">
                                                            Morning wellness
                                                            series
                                                        </span>
                                                        <span class="text-2xl sm:text-3xl">
                                                            <i class="hgi hgi-stroke hgi-rounded hgi-link-square-01"></i>
                                                        </span>
                                                    </a>
                                                </h3>
                                                <div class="text-wrap">
                                                    Sometimes, all you need is a
                                                    little space, fresh air and
                                                    the willingness to move.
                                                    Step outside. Feel the
                                                    ground beneath your feet.
                                                    Look around. Take a few deep
                                                    breaths. Let your body wake
                                                    up before the rest of the
                                                    world starts demanding your
                                                    attention.
                                                </div>
                                            </main>
                                            <footer class="flex justify-between mt-12 items-center">
                                                <div>
                                                    <span class="flex gap-3 font-semibold text-xl">
                                                        <h4>From:</h4>
                                                        <span>GHC700.00</span>
                                                    </span>
                                                </div>
                                                <div class="flex gap-5 items-center">
                                                    <!-- <span>
                                                        <a
                                                            class="btn"
                                                            href="https://wa.me/2330579994032"
                                                        >
                                                            View experience
                                                        </a>
                                                    </span> -->
                                                    <span>
                                                        <a
                                                            class="btn"
                                                            href="https://wa.me/233535180741"
                                                            target="_blank"
                                                        >
                                                            Book now
                                                        </a>
                                                    </span>
                                                </div>
                                            </footer>
                                        </div>

                                        <div class="w-full md:w-[50%]">
                                            <img
                                                src="https://plus.unsplash.com/premium_photo-1791571264917-fe4ae02a102d?w=900&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
                                                alt="Upcoming tours"
                                                class="w-full h-64 sm:h-80 md:h-full object-cover rounded-3xl"
                                            />
                                        </div>
                                    </div>
                                </div>

                                <!-- experience 3 -->
                                <div>
                                    <div
                                        class="flex flex-col md:flex-row justify-between gap-6 md:gap-8 mt-8 md:mt-12"
                                        x-show="current === 2"
                                    >
                                        <div class="w-full md:w-[50%] border p-5 sm:p-8 md:p-10 rounded-3xl tour-shadow-skin">
                                            <main class="space-y-6 md:space-y-9">
                                                <h3 class="font-semibold">
                                                    <a
                                                        href=""
                                                        class="hover:underline flex items-center justify-between"
                                                    >
                                                        <span class="text-2xl sm:text-2xl">
                                                            Mens retreat
                                                        </span>
                                                        <span class="text-2xl sm:text-3xl">
                                                            <i class="hgi hgi-stroke hgi-rounded hgi-link-square-01"></i>
                                                        </span>
                                                    </a>
                                                </h3>
                                                <div class="text-wrap">
                                                    A moment to step away from
                                                    the noise, reconnect with
                                                    yourself, reflect on life,
                                                    build meaningful
                                                    connections, and rediscover
                                                    the man within. Sometimes,
                                                    the strongest thing a man
                                                    can do is pause, reflect,
                                                    and give himself room to
                                                    grow. Gentlemen, this is
                                                    your reminder. The Man
                                                    Within is calling.
                                                </div>
                                            </main>
                                            <footer class="flex justify-between mt-12 items-center">
                                                <div>
                                                    <span class="flex gap-3 font-semibold text-xl">
                                                        <h4>From:</h4>
                                                        <span>GHC900.00</span>
                                                    </span>
                                                </div>
                                                <div class="flex gap-5 items-center">
                                                    <!-- <span>
                                                        <a
                                                            class="btn"
                                                            href="https://wa.me/2330579994032"
                                                        >
                                                            View experience
                                                        </a>
                                                    </span> -->
                                                    <span>
                                                        <a
                                                            class="btn"
                                                            href="https://wa.me/233535180741"
                                                            target="_blank"
                                                        >
                                                            Book now
                                                        </a>
                                                    </span>
                                                </div>
                                            </footer>
                                        </div>

                                        <div class="w-full md:w-[50%]">
                                            <img
                                                src="https://images.unsplash.com/photo-1764341256580-38869ac74eba?w=900&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
                                                alt="Upcoming tours"
                                                class="w-full h-64 sm:h-80 md:h-full object-cover rounded-3xl"
                                            />
                                        </div>
                                    </div>
                                </div>

                                <!-- Add more experiences here using the same structure.
                                     Set x-show="current === 2", then 3, 4, and so on. -->
                            </main>

                            <footer class="flex justify-end mt-8 md:mt-12 gap-3 text-2xl">
                                <div>
                                    <!-- button left -->
                                    <button
                                        class="btn"
                                        @click="previous()"
                                        :disabled="current === 0"
                                        :class="{ 'opacity-40 cursor-not-allowed': current === 0 }"
                                        aria-label="Previous experience"
                                    >
                                        <i class="hgi hgi-stroke hgi-rounded hgi-arrow-left-02"></i>
                                    </button>
                                </div>
                                <div>
                                    <!-- button right -->
                                    <button
                                        class="btn"
                                        @click="next()"
                                        :disabled="current === total - 1"
                                        :class="{ 'opacity-40 cursor-not-allowed': current === total - 1 }"
                                        aria-label="Next experience"
                                    >
                                        <i class="hgi hgi-stroke hgi-rounded hgi-arrow-right-02"></i>
                                    </button>
                                </div>
                            </footer>
                        </div>
                    </div>
                </section>
            </div>
        </section>

        <!-- Past Tours -->
        <section class="bg-[#f4f1e8] py-20 md:py-32">
            <div class="container mx-auto px-6">
                <div class="mx-auto max-w-7xl">
                    <div class="mb-12 flex flex-col gap-5 md:mb-16 md:flex-row md:items-end md:justify-between">
                        <div>
                            <p class="text-xs font-medium uppercase tracking-[0.3em]">
                                From our archives
                            </p>

                            <h2 class="mt-3 text-6xl font-semibold tracking-normal">
                                Past tours
                            </h2>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                        <a
                            href="/"
                            class="relative group border rounded-[1.75rem] p-8 bg-white hover:tour-shadow-skin"
                        >
                            <div class="relative w-20 h-20 overflow-hidden">
                                <img
                                    src="https://images.unsplash.com/vector-1757328201112-2d160c5f21c7?w=900&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
                                    alt="Past tour"
                                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105 rounded-full border border-[#252525]"
                                />
                            </div>

                            <div class="">
                                <h3 class="mt-8 text-3xl text-wrap font-medium">
                                    Campbuzz 5.0: The Grand Final
                                </h3>

                                <p class="mt-6 leading-6 tracking-wide font-light">
                                    Two days. One night. An unforgettable
                                    camping adventure at Adoko Farms Eco Resort.
                                    From quad biking and sunrise hiking to
                                    farm-to-table meals, bonfire nights, movies
                                    under the stars and new friendships, this is
                                    your chance to step away from the routine
                                    and experience camping in Ghana differently.
                                </p>
                            </div>

                            <span class="absolute inline-block text-3xl top-12 right-12">
                                <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-right-01"></i>
                            </span>
                        </a>

                        <a
                            href="/"
                            class="relative group border rounded-[1.75rem] p-8 bg-white"
                        >
                            <div class="relative w-20 h-20 overflow-hidden">
                                <img
                                    src="https://images.unsplash.com/vector-1790770738539-e8cd7c065ba6?w=900&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
                                    alt="Past tour"
                                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105 rounded-full hover:rounded-full border border-[#252525]"
                                />
                            </div>

                            <div class="">
                                <h3 class="mt-8 text-[28px] text-wrap font-medium leading-9.5">
                                    The Man Within - Mens Retreat
                                </h3>

                                <p class="mt-6 leading-6 tracking-wide font-light">
                                    A moment to step away from the noise,
                                    reconnect with yourself, reflect on life,
                                    build meaningful connections, and rediscover
                                    the man within. Sometimes, the strongest
                                    thing a man can do is pause, reflect, and
                                    give himself room to grow. Gentlemen, this
                                    is your reminder. The Man Within is calling.
                                </p>
                            </div>

                            <span class="absolute inline-block text-3xl top-12 right-12">
                                <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-right-01"></i>
                            </span>
                        </a>

                        <a
                            href="/"
                            class="relative group border rounded-[1.75rem] p-8 bg-white"
                        >
                            <div class="relative w-20 h-20 overflow-hidden">
                                <img
                                    src="https://images.unsplash.com/vector-1770415184241-7a62d44d10c7?w=900&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
                                    alt="Past tour"
                                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105 rounded-full hover:rounded-full border border-[#252525]"
                                />
                            </div>

                            <div class="">
                                <h3 class="mt-8 text-3xl text-wrap font-medium">
                                    Morning Wellness Series
                                </h3>

                                <p class="mt-6 text-[16px] tracking-wide font-light leading-7">
                                    Sometimes, all you need is a little space,
                                    fresh air and the willingness to move. Step
                                    outside. Feel the ground beneath your feet.
                                    Look around. Take a few deep breaths. Let
                                    your body wake up before the rest of the
                                    world starts demanding your attention.
                                </p>
                            </div>

                            <span class="absolute inline-block text-3xl top-12 right-12">
                                <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-right-01"></i>
                            </span>
                        </a>

                        <a
                            href="/"
                            class="relative group border rounded-[1.75rem] p-8 bg-white"
                        >
                            <div class="relative w-20 h-20 overflow-hidden">
                                <img
                                    src="https://plus.unsplash.com/premium_vector-1739946145801-0643eacf5d2e?w=900&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
                                    alt="Past tour"
                                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105 rounded-full hover:rounded-full border border-[#252525]"
                                />
                            </div>

                            <div class="">
                                <h3 class="mt-8 text-3xl text-wrap font-medium">
                                    Odwira Farm Stay Vibe
                                </h3>

                                <p class="mt-6 leading-6 tracking-wide font-light">
                                    Experience Odwira in Akropong and stay in
                                    the peaceful surroundings of Adoko Farms.
                                    Odwira in town. Your stay in nature.
                                </p>
                                <ul class="mt-3">
                                    <li>⛺ 3 Nights Tent Accommodation</li>
                                    <li>🍽️ Local Farm-to-Table Brunch</li>
                                    <li>🌿 Peaceful Farm Setting</li>
                                    <li>✨ Time to Relax & Unwind</li>
                                </ul>
                            </div>

                            <span class="absolute inline-block text-3xl top-12 right-12">
                                <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-right-01"></i>
                            </span>
                        </a>

                        <a
                            href="/"
                            class="relative group border rounded-[1.75rem] p-8 bg-white"
                        >
                            <div class="relative w-20 h-20 overflow-hidden">
                                <img
                                    src="https://images.unsplash.com/vector-1785553062785-959c5e28e361?w=900&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
                                    alt="Past tour"
                                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105 rounded-full hover:rounded-full border border-[#252525]"
                                />
                            </div>

                            <div class="">
                                <h3 class="mt-8 text-3xl text-wrap font-medium">
                                    Campbuzz 4.0: 24hr of Extreme Adventure
                                </h3>

                                <p class="mt-6 leading-6 tracking-wide font-light">
                                    Whether you’re coming alone to meet new
                                    people or with someone special, Campbuzz is
                                    designed to leave you refreshed, inspired,
                                    and with memories you’ll talk about long
                                    after the weekend ends.
                                </p>
                            </div>

                            <span class="absolute inline-block text-3xl top-12 right-12">
                                <i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-right-01"></i>
                            </span>
                        </a>
                    </div>

                    <div class="mt-20 text-center">
                        <a
                            href="#"
                            class="inline-flex items-center gap-2 rounded-full btn"
                        >
                            <span>Load more past tours</span>
                            <i class="hgi hgi-stroke hgi-rounded hgi-arrow-down-01 text-2xl"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <!-- Data -->
    </Page>
</Layout>
