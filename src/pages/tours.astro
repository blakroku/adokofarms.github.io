---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";
import Hero from "../components/Hero.astro";
---

<Layout title="Tours">
    <Page>
        <Hero
            heroTitle="Out tours"
            firstHeroTitle="What is"
            secondHeroTitle="happening?"
        />

        <!-- Upcoming Tours -->
        <section class="py-20 md:py-32">
            <div class="container mx-auto px-6">
                <div class="mx-auto max-w-7xl">
                    <div class="mb-12 flex flex-col gap-5 md:mb-16 md:flex-row md:items-end md:justify-between">
                        <div>
                            <p class="text-xs font-medium uppercase tracking-[0.3em]">
                                Coming up
                            </p>

                            <h2 class="mt-3 text-4xl font-light tracking-tight md:text-5xl">
                                Current tours
                            </h2>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
                        <!-- Current Tour -->
                        <article class="group overflow-hidden rounded-[2rem] border border-gray-200 bg-[#252525]">
                            <div class="relative h-90 overflow-hidden">
                                <img
                                    src="https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1400&q=85"
                                    alt="Tour"
                                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                                />

                                <div class="absolute left-6 top-6 rounded-full bg-white px-4 py-2 text-xs font-medium uppercase tracking-[0.15em]">
                                    Upcoming
                                </div>
                            </div>

                            <div class="p-7 md:p-8 text-white/60">
                                <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.2em]">
                                    <span>12 – 15 December 2026</span>
                                    <span>•</span>
                                    <span>4 days</span>
                                </div>

                                <h3 class="mt-4 text-3xl font-light">
                                    Volta Adventure
                                </h3>

                                <p class="mt-4 max-w-xl text-sm leading-7">
                                    A journey through the Volta region,
                                    connecting landscapes, communities, food,
                                    and experiences along the way.
                                </p>

                                <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                                    <span class="text-sm">
                                        From $XXX / person
                                    </span>

                                    <div class="flex gap-3">
                                        <a
                                            href="#"
                                            class="inline-flex items-center justify-center rounded-full border border-[#263b2a] px-5 py-2.5 text-sm transition hover:bg-[#263b2a] hover:text-white"
                                        >
                                            View tour
                                        </a>

                                        <a
                                            href="#"
                                            class="inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm text-white transition hover:bg-[#1c2d20]"
                                        >
                                            Book now
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>

                        <!-- Current Tour -->
                        <article class="group overflow-hidden rounded-[2rem] border border-gray-200 bg-white">
                            <div class="relative h-[360px] overflow-hidden">
                                <img
                                    src="https://images.unsplash.com/photo-1433086966358-54859d0ed716?auto=format&fit=crop&w=1400&q=85"
                                    alt="Tour"
                                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                                />

                                <div class="absolute left-6 top-6 rounded-full bg-white px-4 py-2 text-xs font-medium uppercase tracking-[0.15em] text-[#263b2a]">
                                    Upcoming
                                </div>
                            </div>

                            <div class="p-7 md:p-8">
                                <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.2em] text-[#66705f]">
                                    <span>January 2027</span>
                                    <span>•</span>
                                    <span>3 days</span>
                                </div>

                                <h3 class="mt-4 text-3xl font-light text-[#263b2a]">
                                    Nature & Countryside Escape
                                </h3>

                                <p class="mt-4 max-w-xl text-sm leading-7 text-gray-600">
                                    Slow down and experience the natural beauty,
                                    rural landscapes, and quiet places beyond
                                    the usual tourist routes.
                                </p>

                                <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                                    <span class="text-sm text-gray-500">
                                        From $XXX / person
                                    </span>

                                    <div class="flex gap-3">
                                        <a
                                            href="#"
                                            class="inline-flex items-center justify-center rounded-full border border-[#263b2a] px-5 py-2.5 text-sm text-[#263b2a] transition hover:bg-[#263b2a] hover:text-white"
                                        >
                                            View tour
                                        </a>

                                        <a
                                            href="#"
                                            class="inline-flex items-center justify-center rounded-full bg-[#263b2a] px-5 py-2.5 text-sm text-white transition hover:bg-[#1c2d20]"
                                        >
                                            Book now
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
            </div>
        </section>

        <!-- Past Tours -->
        <section class="bg-[#f4f1e8] py-20 md:py-32">
            <div class="container mx-auto px-6">
                <div class="mx-auto max-w-7xl">
                    <div class="mb-12 flex flex-col gap-5 md:mb-16 md:flex-row md:items-end md:justify-between">
                        <div>
                            <p class="text-xs font-medium uppercase tracking-[0.3em] text-[#66705f]">
                                From our journal
                            </p>

                            <h2 class="mt-3 text-4xl font-light tracking-tight text-[#263b2a] md:text-5xl">
                                Past tours
                            </h2>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                        <!-- Past Tour -->
                        <article class="group overflow-hidden rounded-[1.75rem] bg-white">
                            <div class="relative h-72 overflow-hidden">
                                <img
                                    src="https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1000&q=85"
                                    alt="Past tour"
                                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                                />
                            </div>

                            <div class="p-6">
                                <p class="text-xs uppercase tracking-[0.2em] text-[#66705f]">
                                    August 2026
                                </p>

                                <h3 class="mt-3 text-2xl font-light text-[#263b2a]">
                                    Eastern Region Escape
                                </h3>

                                <p class="mt-3 text-sm leading-6 text-gray-600">
                                    A journey through the landscapes and
                                    communities of Ghana's Eastern Region.
                                </p>

                                <a
                                    href="#"
                                    class="mt-5 inline-flex items-center gap-2 text-sm text-[#263b2a] underline underline-offset-4"
                                >
                                    View tour
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="size-4"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                        />
                                    </svg>
                                </a>
                            </div>
                        </article>

                        <!-- Past Tour -->
                        <article class="group overflow-hidden rounded-[1.75rem] bg-white">
                            <div class="relative h-72 overflow-hidden">
                                <img
                                    src="https://images.unsplash.com/photo-1433086966358-54859d0ed716?auto=format&fit=crop&w=1000&q=85"
                                    alt="Past tour"
                                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                                />
                            </div>

                            <div class="p-6">
                                <p class="text-xs uppercase tracking-[0.2em] text-[#66705f]">
                                    July 2026
                                </p>

                                <h3 class="mt-3 text-2xl font-light text-[#263b2a]">
                                    Forest & Waterfalls
                                </h3>

                                <p class="mt-3 text-sm leading-6 text-gray-600">
                                    A few days exploring forests, waterfalls,
                                    trails, and the countryside.
                                </p>

                                <a
                                    href="#"
                                    class="mt-5 inline-flex items-center gap-2 text-sm text-[#263b2a] underline underline-offset-4"
                                >
                                    View tour
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="size-4"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                        />
                                    </svg>
                                </a>
                            </div>
                        </article>

                        <!-- Past Tour -->
                        <article class="group overflow-hidden rounded-[1.75rem] bg-white">
                            <div class="relative h-72 overflow-hidden">
                                <img
                                    src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1000&q=85"
                                    alt="Past tour"
                                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                                />
                            </div>

                            <div class="p-6">
                                <p class="text-xs uppercase tracking-[0.2em] text-[#66705f]">
                                    May 2026
                                </p>

                                <h3 class="mt-3 text-2xl font-light text-[#263b2a]">
                                    Countryside Adventure
                                </h3>

                                <p class="mt-3 text-sm leading-6 text-gray-600">
                                    A slower journey through rural Ghana,
                                    connecting people, food, nature, and
                                    culture.
                                </p>

                                <a
                                    href="#"
                                    class="mt-5 inline-flex items-center gap-2 text-sm text-[#263b2a] underline underline-offset-4"
                                >
                                    View tour
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="size-4"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                        />
                                    </svg>
                                </a>
                            </div>
                        </article>
                    </div>

                    <div class="mt-10 text-center">
                        <a
                            href="#"
                            class="inline-flex items-center gap-2 rounded-full border border-[#263b2a] px-7 py-3 text-sm text-[#263b2a] transition hover:bg-[#263b2a] hover:text-white"
                        >
                            View all past tours
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="size-4"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <!-- Data -->
    </Page>
</Layout>
