---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";
---

<Layout title="Contact">
    <Page>
        <!-- Contact Hero -->
        <header class="container mx-auto text-center py-32 bg-[#252525] text-white bg-[url('../assets/ad.png')] bg-cover bg-center overflow-hidden relative">
            <div>
                <div>
                    <span class="text-sm uppercase tracking-widest">
                        Contact us
                    </span>
                </div>
                <div class="pb-5">
                    <span class="text-4xl md:text-5xl font-black flex flex-col gap-2 tracking-wide px-4 md:px-0">
                        <span>We'd love to</span>
                        <span>hear from you</span>
                    </span>
                </div>
                <span class="w-10 h-1.5 rounded-full bg-[#F54A00] inline-block"></span>
            </div>
        </header>

        <!-- Contact Content -->
        <section class="py-20 md:py-28">
            <div class="container mx-auto px-6">
                <div class="mx-auto grid max-w-6xl gap-16 md:grid-cols-2 md:gap-24">
                    <!-- Contact Information -->
                    <div class="flex flex-col justify-center">
                        <p class="text-xs font-medium uppercase tracking-[0.3em]">
                            Contact us
                        </p>

                        <h2 class="mt-4 text-4xl font-light tracking-tight md:text-5xl">
                            Start planning your visit
                        </h2>

                        <p class="mt-6 max-w-lg text-base leading-8">
                            Adoko Farms is a working farm and agrotourism
                            destination in Akropong-Akuapem, about 54km from
                            Accra. Reach out and let us know how we can make
                            your visit special.
                        </p>

                        <div class="mt-10 space-y-7">
                            <!-- Location -->
                            <div class="flex gap-4">
                                <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-[#252525] text-white/90">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="size-5"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                                        ></path>
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                                        ></path>
                                    </svg>
                                </div>

                                <div>
                                    <p class="font-medium">Location</p>

                                    <p class="mt-1">Akropong-Akuapem, Ghana</p>
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="flex gap-4">
                                <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-[#252525] text-white/90">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="size-5"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25H4.5a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5H4.5a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0l-7.5-4.615A2.25 2.25 0 0 1 2.25 6.993V6.75"
                                        ></path>
                                    </svg>
                                </div>

                                <div>
                                    <p class="font-medium">Email</p>

                                    <a
                                        href="mailto:booking@adokofarms.com"
                                        class="mt-1 block"
                                    >
                                        booking@adokofarms.com
                                    </a>
                                </div>
                            </div>

                            <!-- Phone -->
                            <div class="flex gap-4">
                                <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-[#252525] text-white/90">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="size-5"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.09l-4.423-1.106c-.45-.113-.91.055-1.18.423l-.97 1.293c-.267.356-.718.524-1.14.352a12.035 12.035 0 0 1-6.946-6.946c-.172-.422-.004-.873.352-1.14l1.293-.97c.368-.27.536-.73.423-1.18L7.846 3.341A1.125 1.125 0 0 0 6.756 2.5H5.25A3 3 0 0 0 2.25 5.5v1.25Z"
                                        ></path>
                                    </svg>
                                </div>

                                <div>
                                    <p class="font-medium">Phone</p>

                                    <a
                                        href="tel:+233535180741"
                                        class="mt-1 block"
                                    >
                                        +233 53 518 0741
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Form -->
                    <div class="bg-[#EAE8E5] p-6 md:p-10">
                        <div class="mb-8">
                            <p class="text-xs font-medium uppercase tracking-[0.3em] text-[#66705f]">
                                Send a message
                            </p>

                            <h2 class="mt-3 text-3xl font-light text-[#263b2a]">
                                Tell us about your plans
                            </h2>
                        </div>

                        <form class="space-y-6">
                            <div>
                                <!-- <label
                                    for="name"
                                    class="mb-2 block text-sm text-gray-700"
                                >
                                    Your name
                                </label> -->

                                <input
                                    id="name"
                                    type="text"
                                    name="name"
                                    class="w-full bg-white px-4 py-3.5 outline-none"
                                    placeholder="Your name"
                                />
                            </div>

                            <div>
                                <!-- <label
                                    for="email"
                                    class="mb-2 block text-sm text-gray-700"
                                >
                                    Email address
                                </label> -->

                                <input
                                    id="email"
                                    type="email"
                                    name="email"
                                    class="w-full bg-white px-4 py-3.5 outline-none"
                                    placeholder="you@example.com"
                                />
                            </div>

                            <div>
                                <!-- <label
                                    for="subject"
                                    class="mb-2 block text-sm text-gray-700"
                                >
                                    What are you interested in?
                                </label> -->

                                <select
                                    id="subject"
                                    name="subject"
                                    class="w-full bg-white px-4 py-3.5 outline-none"
                                >
                                    <option value="">Select an option</option>
                                    <option value="farm-stay">Farm Stay</option>
                                    <option value="camping">Camping</option>
                                    <option value="farm-tour">
                                        Guided Farm Tour
                                    </option>
                                    <option value="farm-to-table">
                                        Farm To Table Dining
                                    </option>
                                    <option value="nature">
                                        Nature Experience
                                    </option>
                                    <option value="day-visit">Day Visit</option>
                                    <option value="other">
                                        Something else
                                    </option>
                                </select>
                            </div>

                            <div>
                                <!-- <label
                                    for="message"
                                    class="mb-2 block text-sm text-gray-700"
                                >
                                    Your message
                                </label> -->

                                <textarea
                                    id="message"
                                    name="message"
                                    rows="5"
                                    class="w-full resize-none bg-white px-4 py-3.5 outline-none"
                                    placeholder="Tell us what you're planning..."
                                ></textarea>
                            </div>

                            <button
                                type="submit"
                                class="bg-[#252525] px-6 py-4 rounded-full text-white cursor-pointer"
                            >
                                Send your message
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <!-- Visit Section -->
        <section class="bg-[#EAE8E5] py-20 md:py-24 container mx-auto rounded-2xl">
            <div class="container mx-auto px-6">
                <div class="mx-auto max-w-3xl text-center">
                    <p class="text-xs font-medium uppercase tracking-[0.35em]">
                        Come visit us
                    </p>

                    <h2 class="mt-5 text-4xl font-light tracking-tight md:text-5xl">
                        Escape the city and Experience rural Ghana.
                    </h2>
                    <!--
                    <p class="mx-auto mt-6 max-w-2xl text-sm leading-7 text-white/70 md:text-base">
                        Find your way to Adoko Farms and discover a slower, more
                        authentic side of Ghana.
                    </p> -->

                    <div class="mt-8">
                        <a
                            href="/directions"
                            class="hover:underline flex items-center gap-2 justify-center"
                        >
                            <span>Get directions</span>
                            <span>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="1.5"
                                    stroke="currentColor"
                                    class="size-6"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"
                                    />
                                </svg>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </Page>
</Layout>
