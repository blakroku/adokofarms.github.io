---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";
import Hero from "../components/HeroContact.astro";
---

<Layout title="Contact">
    <Page>
        <Hero
            heroTitle="Contact us"
            firstHeroTitle="We'd like to"
            secondHeroTitle="hear from you"
        />

        <!-- Contact Content -->
        <section class="py-20 md:py-20">
            <div class="container mx-auto px-6">
                <section class="w-full md:w-242.5 md:mx-auto mt-12 mb-20">
                    <div class="flex justify-center">
                        <div class="space-y-6 text-xl">
                            <div>
                                <span class="block">Location:</span>
                                <span class="block underline">
                                    Akropong Akwapem
                                </span>
                            </div>
                            <!-- <div>
                                <span class="block">
                                    If you like to make a suggestion:
                                </span>
                                <span class="block underline cursor-pointer">
                                    suggestions@adokofarms.com
                                </span>
                            </div> -->
                            <div>
                                <span class="block">Ask about our events:</span>
                                <span class="block underline cursor-pointer">
                                    booking@adokofarms.com
                                </span>
                            </div>
                            <div class="mt-20">
                                <div class="space-y-3">
                                    <div>
                                        <a
                                            href="javascript:void(0)"
                                            id="open-crisp-chat"
                                            class="bg-[#252525] text-white py-4 rounded-md px-12 cursor-pointer shadow inline-flex items-center gap-2 cc-157aw cc-1kgzy"
                                        >
                                            <span>
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="24"
                                                    height="24"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-mail-forward"
                                                >
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M12 18h-7a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v7.5" />
                                                    <path d="M3 6l9 6l9 -6" />
                                                    <path d="M15 18h6" />
                                                    <path d="M18 15l3 3l-3 3" />
                                                </svg>
                                            </span>
                                            <span>Email us</span>
                                        </a>
                                    </div>
                                    <div>
                                        <a
                                            href="https://wa.me/0535180741"
                                            target="_blank"
                                            id="open-crisp-chat"
                                            class="bg-[#3BD877] text-white py-4 rounded-md px-12 cursor-pointer shadow inline-flex items-center gap-2 cc-157aw cc-1kgzy"
                                        >
                                            <span>
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="24"
                                                    height="24"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"
                                                >
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
                                                    <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
                                                </svg>
                                            </span>
                                            <span>Message us on WhatsApp</span>
                                        </a>
                                    </div>
                                </div>

                                <div class="my-12">
                                    <div>
                                        <span>
                                            <span>
                                                <span class="">
                                                    Prefer to call us?
                                                </span>
                                                <small class="text-xs block">
                                                    This is also our whatsapp
                                                    contact
                                                </small>
                                            </span>
                                        </span>
                                        <a
                                            href="tel:0535180741"
                                            class="flex items-center gap-1 cursor-pointer"
                                        >
                                            <span>
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="24"
                                                    height="24"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-phone"
                                                >
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" />
                                                </svg>
                                            </span>
                                            <span>(+233) 53 518 0741</span>
                                        </a>
                                    </div>
                                    <div class="mt-6">
                                        <span class="flex items-center gap-1">
                                            <span>I want to visit:</span>
                                        </span>
                                        <a
                                            href="/directions"
                                            class="flex items-center gap-1 cursor-pointer"
                                        >
                                            <span>
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="24"
                                                    height="24"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-directions"
                                                >
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M12 21v-4" />
                                                    <path d="M12 13v-4" />
                                                    <path d="M12 5v-2" />
                                                    <path d="M10 21h4" />
                                                    <path d="M8 5v4h11l2 -2l-2 -2z" />
                                                    <path d="M14 13v4h-8l-2 -2l2 -2z" />
                                                </svg>
                                            </span>
                                            <span>Get directions</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </section>
    </Page>
</Layout>
