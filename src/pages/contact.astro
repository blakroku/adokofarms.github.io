---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";
---

<Layout title="Contact">
    <Page>
        <!-- Contact Hero -->
        <section class="relative overflow-hidden bg-[#f4f1e8] py-24 md:py-32">
            <div class="container mx-auto px-6">
                <div class="mx-auto max-w-4xl text-center">
                    <p class="text-xs font-medium uppercase tracking-[0.35em] text-[#66705f]">
                        Get in touch
                    </p>

                    <h1 class="mt-5 text-5xl font-light tracking-tight text-[#263b2a] md:text-7xl">
                        We'd love to hear from you
                    </h1>

                    <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-gray-600 md:text-lg">
                        Whether you're planning a farm stay, a day visit, or an
                        experience in rural Ghana, we're here to help you plan
                        your escape.
                    </p>
                </div>
            </div>
        </section>

        <!-- Contact Content -->
        <section class="bg-white py-20 md:py-28">
            <div class="container mx-auto px-6">
                <div class="mx-auto grid max-w-6xl gap-16 md:grid-cols-2 md:gap-24">
                    <!-- Contact Information -->
                    <div class="flex flex-col justify-center">
                        <p class="text-xs font-medium uppercase tracking-[0.3em] text-[#66705f]">
                            Contact us
                        </p>

                        <h2 class="mt-4 text-4xl font-light tracking-tight text-[#263b2a] md:text-5xl">
                            Start planning your visit
                        </h2>

                        <p class="mt-6 max-w-lg text-base leading-8 text-gray-600">
                            Adoko Farms is a working farm and agrotourism
                            destination in Akropong-Akuapem, about 54km from
                            Accra. Reach out and let us know how we can make
                            your visit special.
                        </p>

                        <div class="mt-10 space-y-7">
                            <!-- Location -->
                            <div class="flex gap-4">
                                <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-[#eef0e8] text-[#263b2a]">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="size-5"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                                        ></path>
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                                        ></path>
                                    </svg>
                                </div>

                                <div>
                                    <p class="font-medium text-gray-900">
                                        Location
                                    </p>

                                    <p class="mt-1 text-gray-600">
                                        Akropong-Akuapem, Ghana
                                    </p>
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="flex gap-4">
                                <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-[#eef0e8] text-[#263b2a]">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="size-5"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25H4.5a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5H4.5a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0l-7.5-4.615A2.25 2.25 0 0 1 2.25 6.993V6.75"
                                        ></path>
                                    </svg>
                                </div>

                                <div>
                                    <p class="font-medium text-gray-900">
                                        Email
                                    </p>

                                    <a
                                        href="mailto:booking@adokofarms.com"
                                        class="mt-1 block text-gray-600 transition hover:text-[#263b2a]"
                                    >
                                        booking@adokofarms.com
                                    </a>
                                </div>
                            </div>

                            <!-- Phone -->
                            <div class="flex gap-4">
                                <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-[#eef0e8] text-[#263b2a]">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="size-5"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.09l-4.423-1.106c-.45-.113-.91.055-1.18.423l-.97 1.293c-.267.356-.718.524-1.14.352a12.035 12.035 0 0 1-6.946-6.946c-.172-.422-.004-.873.352-1.14l1.293-.97c.368-.27.536-.73.423-1.18L7.846 3.341A1.125 1.125 0 0 0 6.756 2.5H5.25A3 3 0 0 0 2.25 5.5v1.25Z"
                                        ></path>
                                    </svg>
                                </div>

                                <div>
                                    <p class="font-medium text-gray-900">
                                        Phone
                                    </p>

                                    <a
                                        href="tel:+233535180741"
                                        class="mt-1 block text-gray-600 transition hover:text-[#263b2a]"
                                    >
                                        +233 53 518 0741
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Form -->
                    <div class="rounded-[2rem] bg-[#f4f1e8] p-6 md:p-10">
                        <div class="mb-8">
                            <p class="text-xs font-medium uppercase tracking-[0.3em] text-[#66705f]">
                                Send a message
                            </p>

                            <h2 class="mt-3 text-3xl font-light text-[#263b2a]">
                                Tell us about your plans
                            </h2>
                        </div>

                        <form class="space-y-6">
                            <div>
                                <label
                                    for="name"
                                    class="mb-2 block text-sm text-gray-700"
                                >
                                    Your name
                                </label>

                                <input
                                    id="name"
                                    type="text"
                                    name="name"
                                    class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3.5 outline-none transition focus:border-[#263b2a]"
                                    placeholder="Your name"
                                />
                            </div>

                            <div>
                                <label
                                    for="email"
                                    class="mb-2 block text-sm text-gray-700"
                                >
                                    Email address
                                </label>

                                <input
                                    id="email"
                                    type="email"
                                    name="email"
                                    class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3.5 outline-none transition focus:border-[#263b2a]"
                                    placeholder="you@example.com"
                                />
                            </div>

                            <div>
                                <label
                                    for="subject"
                                    class="mb-2 block text-sm text-gray-700"
                                >
                                    What are you interested in?
                                </label>

                                <select
                                    id="subject"
                                    name="subject"
                                    class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3.5 outline-none transition focus:border-[#263b2a]"
                                >
                                    <option value="">Select an option</option>
                                    <option value="farm-stay">Farm Stay</option>
                                    <option value="camping">Camping</option>
                                    <option value="farm-tour">
                                        Guided Farm Tour
                                    </option>
                                    <option value="farm-to-table">
                                        Farm To Table Dining
                                    </option>
                                    <option value="nature">
                                        Nature Experience
                                    </option>
                                    <option value="day-visit">Day Visit</option>
                                    <option value="other">
                                        Something else
                                    </option>
                                </select>
                            </div>

                            <div>
                                <label
                                    for="message"
                                    class="mb-2 block text-sm text-gray-700"
                                >
                                    Your message
                                </label>

                                <textarea
                                    id="message"
                                    name="message"
                                    rows="5"
                                    class="w-full resize-none rounded-xl border border-gray-300 bg-white px-4 py-3.5 outline-none transition focus:border-[#263b2a]"
                                    placeholder="Tell us what you're planning..."
                                ></textarea>
                            </div>

                            <button
                                type="submit"
                                class="btn-book flex w-full! justify-center! py-4!"
                            >
                                Send your message
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <!-- Visit Section -->
        <section class="bg-[#263b2a] py-20 text-white md:py-24">
            <div class="container mx-auto px-6">
                <div class="mx-auto max-w-3xl text-center">
                    <p class="text-xs font-medium uppercase tracking-[0.35em] text-white/60">
                        Come visit us
                    </p>

                    <h2 class="mt-5 text-4xl font-light tracking-tight md:text-5xl">
                        Escape the city. Experience rural Ghana.
                    </h2>

                    <p class="mx-auto mt-6 max-w-2xl text-sm leading-7 text-white/70 md:text-base">
                        Find your way to Adoko Farms and discover a slower, more
                        authentic side of Ghana.
                    </p>

                    <div class="mt-8">
                        <a
                            href="/directions"
                            class="inline-flex rounded-full border border-white/40 px-7 py-3 text-sm transition hover:bg-white hover:text-[#263b2a]"
                        >
                            Get directions
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </Page>
</Layout>
