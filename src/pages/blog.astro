---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";
import Hero from "../components/Hero.astro";
const title = "Blog";
---

<Layout title={title}>
    <Page>
        <header>
            <div class="text-center py-20">
                <div class="flex justify-center mb-3">
                    <div class="border-2 text-[#322E28] font-semibold border-[#322E28] inline-flex justify-center px-5 py-2 rounded-full text-sm tracking-widest uppercase">
                        Blog
                    </div>
                </div>
                <h1 class="text-center hero-font-style">
                    <span class="block">Travel info</span>
                    <span class="block">from us.</span>
                </h1>
                <div class="w-full sm:w-100 px-4 sm:px-0 mx-auto mt-22">
                    <div class="flex flex-wrap gap-3 align-center justify-center">
                        <button class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer">
                            Activities
                        </button>
                        <button class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer">
                            Tours
                        </button>
                        <button class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer">
                            Booking
                        </button>
                        <button class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer">
                            Travel
                        </button>
                        <button class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer">
                            Accomodation
                        </button>
                        <button class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer">
                            Experience
                        </button>
                        <button class="btn rounded-full border px-5 py-2 text-sm font-medium cursor-pointer">
                            Before You Visit
                        </button>
                    </div>
                </div>
                <!-- <div class="w-full sm:w-100 px-4 sm:px-0 mx-auto mt-12">
                    <form role="form">
                        <input
                            class="border rounded-full px-6 py-3"
                            type="search"
                            placeholder="search..."
                        />
                    </form>
                </div> -->
            </div>
        </header>

        <section class="bg-linear-to-br from-[#60B08A] to-[#1E8D5C] py-20 md:py-32">
            <div class="w-full lg:w-312 mx-auto px-6">
