                    <!-- Blog 1 -->
                    <article class="w-full lg:w-[calc(50%-12px)] bg-white p-8 rounded-3xl group">
                        <div class="flex items-start justify-between gap-4">
                            <h2 class="text-3xl font-semibold leading-tight">
                                <a
                                    href="/blog/campbuzz-6-wild-experience"
                                    class="transition-colors duration-200 group-hover:text-[#1E8D5C]"
                                >
                                    Experience the Wild at Adoko Farms
                                </a>
                            </h2>
                            <a
                                href="/blog/campbuzz-6-wild-experience"
                                aria-label="Read Campbuzz 6.0"
                                class="shrink-0 opacity-0 translate-y-1 text-gray-900 group-hover:opacity-100 group-hover:translate-y-0 group-hover:text-[#1E8D5C] transition-all duration-200"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="1.8"
                                    stroke="currentColor"
                                    class="w-10 h-10"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M7 17 17 7M7 7h10v10"
                                    />
                                </svg>
