---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";
---

<Layout title="Activities">
    <Page>
        <!-- Hero -->
        <section class="relative overflow-hidden bg-[#f4f1e8] py-24 md:py-32">
            <div class="container mx-auto px-6">
                <div class="mx-auto max-w-4xl text-center">
                    <p class="text-xs font-medium uppercase tracking-[0.35em] text-[#66705f]">
                        Experiences
                    </p>

                    <h1 class="mt-5 text-5xl font-light tracking-tight text-[#263b2a] md:text-7xl">
                        Explore our activities
                    </h1>

                    <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-gray-600 md:text-lg">
                        Discover authentic experiences that take you beyond the
                        usual tourist trail and into the landscapes, culture,
                        and everyday life of rural Ghana.
                    </p>
                </div>
            </div>
        </section>

        <!-- Activities -->
        <section class="bg-white py-20 md:py-28">
            <div class="container mx-auto px-6">
                <div class="mx-auto max-w-7xl">
                    <!-- Section heading -->
                    <div class="mb-12 flex flex-col gap-4 md:mb-16 md:flex-row md:items-end md:justify-between">
                        <div>
                            <p class="text-xs font-medium uppercase tracking-[0.3em] text-[#66705f]">
                                Choose your experience
                            </p>

                            <h2 class="mt-3 text-4xl font-light tracking-tight text-[#263b2a] md:text-5xl">
                                Find your escape
                            </h2>
                        </div>

                        <p class="max-w-md text-sm leading-7 text-gray-500 md:text-right">
                            From quiet walks through nature to immersive farm
                            and village experiences, there is something for
                            every kind of traveller.
                        </p>
                    </div>

                    <!-- Activity Grid -->
                    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                        <!-- Activity 1 -->
                        <article class="group relative min-h-[480px] overflow-hidden rounded-[2rem] bg-gray-200">
                            <img
                                src="https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1200&q=85"
                                alt="Eco trail"
                                class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                            />

                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

                            <div class="absolute inset-x-0 bottom-0 p-7 text-white md:p-8">
                                <div class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-white/70">
                                    <span>± 1 hour</span>
                                    <span>•</span>
                                    <span>From $90/pp</span>
                                </div>

                                <h3 class="mt-3 text-3xl font-light">
                                    Trail Beyond Limits
                                </h3>

                                <p class="mt-3 max-w-lg text-sm leading-6 text-white/80">
                                    Explore the natural surroundings and
                                    discover a different side of rural Ghana.
                                </p>

                                <div class="mt-6">
                                    <a
                                        href="#"
                                        class="inline-flex items-center gap-2 rounded-full border border-white/50 px-5 py-2.5 text-sm transition hover:bg-white hover:text-[#263b2a]"
                                    >
                                        Book now
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.5"
                                            stroke="currentColor"
                                            class="size-4"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </article>

                        <!-- Activity 2 -->
                        <article class="group relative min-h-[480px] overflow-hidden rounded-[2rem] bg-gray-200">
                            <img
                                src="https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1200&q=85"
                                alt="Morning walk"
                                class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                            />

                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

                            <div class="absolute inset-x-0 bottom-0 p-7 text-white md:p-8">
                                <div class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-white/70">
                                    <span>± 2 hours</span>
                                    <span>•</span>
                                    <span>From $85/pp</span>
                                </div>

                                <h3 class="mt-3 text-3xl font-light">
                                    Two Hour Morning Walk
                                </h3>

                                <p class="mt-3 max-w-lg text-sm leading-6 text-white/80">
                                    Start the day outdoors with a relaxed
                                    journey through the surrounding landscape.
                                </p>

                                <div class="mt-6">
                                    <a
                                        href="#"
                                        class="inline-flex items-center gap-2 rounded-full border border-white/50 px-5 py-2.5 text-sm transition hover:bg-white hover:text-[#263b2a]"
                                    >
                                        Book now
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.5"
                                            stroke="currentColor"
                                            class="size-4"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </article>

                        <!-- Activity 3 -->
                        <article class="group relative min-h-[480px] overflow-hidden rounded-[2rem] bg-gray-200">
                            <img
                                src="https://images.unsplash.com/photo-1501004318641-b39e6451bec6?auto=format&fit=crop&w=1200&q=85"
                                alt="Farm experience"
                                class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                            />

                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

                            <div class="absolute inset-x-0 bottom-0 p-7 text-white md:p-8">
                                <div class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-white/70">
                                    <span>Experience</span>
                                    <span>•</span>
                                    <span>From $85/pp</span>
                                </div>

                                <h3 class="mt-3 text-3xl font-light">
                                    Family Farm Tour
                                </h3>

                                <p class="mt-3 max-w-lg text-sm leading-6 text-white/80">
                                    Step into farm life and learn about the
                                    people, produce, and traditions that shape
                                    the land.
                                </p>

                                <div class="mt-6">
                                    <a
                                        href="#"
                                        class="inline-flex items-center gap-2 rounded-full border border-white/50 px-5 py-2.5 text-sm transition hover:bg-white hover:text-[#263b2a]"
                                    >
                                        Book now
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.5"
                                            stroke="currentColor"
                                            class="size-4"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </article>

                        <!-- Activity 4 -->
                        <article class="group relative min-h-[480px] overflow-hidden rounded-[2rem] bg-gray-200">
                            <img
                                src="https://images.unsplash.com/photo-1531058020387-3be344556be6?auto=format&fit=crop&w=1200&q=85"
                                alt="Village discovery"
                                class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                            />

                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

                            <div class="absolute inset-x-0 bottom-0 p-7 text-white md:p-8">
                                <div class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-white/70">
                                    <span>Experience</span>
                                    <span>•</span>
                                    <span>From $85/pp</span>
                                </div>

                                <h3 class="mt-3 text-3xl font-light">
                                    Village Discovery
                                </h3>

                                <p class="mt-3 max-w-lg text-sm leading-6 text-white/80">
                                    Meet local communities and experience the
                                    rhythms, stories, and culture of rural
                                    Ghana.
                                </p>

                                <div class="mt-6">
                                    <a
                                        href="#"
                                        class="inline-flex items-center gap-2 rounded-full border border-white/50 px-5 py-2.5 text-sm transition hover:bg-white hover:text-[#263b2a]"
                                    >
                                        Book now
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.5"
                                            stroke="currentColor"
                                            class="size-4"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </article>

                        <!-- Activity 5 -->
                        <article class="group relative min-h-[480px] overflow-hidden rounded-[2rem] bg-gray-200">
                            <img
                                src="https://images.unsplash.com/photo-1433086966358-54859d0ed716?auto=format&fit=crop&w=1200&q=85"
                                alt="Forest escape"
                                class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                            />

                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

                            <div class="absolute inset-x-0 bottom-0 p-7 text-white md:p-8">
                                <div class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-white/70">
                                    <span>Nature</span>
                                    <span>•</span>
                                    <span>From $90/pp</span>
                                </div>

                                <h3 class="mt-3 text-3xl font-light">
                                    Forest Escape
                                </h3>

                                <p class="mt-3 max-w-lg text-sm leading-6 text-white/80">
                                    Leave the busy roads behind and spend time
                                    surrounded by Ghana's natural landscape.
                                </p>

                                <div class="mt-6">
                                    <a
                                        href="#"
                                        class="inline-flex items-center gap-2 rounded-full border border-white/50 px-5 py-2.5 text-sm transition hover:bg-white hover:text-[#263b2a]"
                                    >
                                        Book now
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.5"
                                            stroke="currentColor"
                                            class="size-4"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </article>

                        <!-- Activity 6 -->
                        <article class="group relative min-h-[480px] overflow-hidden rounded-[2rem] bg-gray-200">
                            <img
                                src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1200&q=85"
                                alt="Riverside adventure"
                                class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                            />

                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

                            <div class="absolute inset-x-0 bottom-0 p-7 text-white md:p-8">
                                <div class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-white/70">
                                    <span>Nature</span>
                                    <span>•</span>
                                    <span>From $90/pp</span>
                                </div>

                                <h3 class="mt-3 text-3xl font-light">
                                    Riverside Adventure
                                </h3>

                                <p class="mt-3 max-w-lg text-sm leading-6 text-white/80">
                                    Discover quiet waters, green landscapes, and
                                    another side of the Ghanaian countryside.
                                </p>

                                <div class="mt-6">
                                    <a
                                        href="#"
                                        class="inline-flex items-center gap-2 rounded-full border border-white/50 px-5 py-2.5 text-sm transition hover:bg-white hover:text-[#263b2a]"
                                    >
                                        Book now
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.5"
                                            stroke="currentColor"
                                            class="size-4"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="bg-[#263b2a] py-20 text-white md:py-24">
            <div class="container mx-auto px-6">
                <div class="mx-auto max-w-3xl text-center">
                    <p class="text-xs font-medium uppercase tracking-[0.35em] text-white/60">
                        Your next escape
                    </p>

                    <h2 class="mt-5 text-4xl font-light tracking-tight md:text-5xl">
                        Ready to experience rural Ghana?
                    </h2>

                    <p class="mx-auto mt-6 max-w-2xl text-sm leading-7 text-white/70 md:text-base">
                        Choose an experience, plan your visit, and discover a
                        different side of Ghana.
                    </p>

                    <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
                        <a
                            href="/contact"
                            class="inline-flex justify-center rounded-full bg-white px-7 py-3 text-sm text-[#263b2a] transition hover:bg-white/90"
                        >
                            Plan your visit
                        </a>

                        <a
                            href="/accommodation"
                            class="inline-flex justify-center rounded-full border border-white/40 px-7 py-3 text-sm transition hover:bg-white hover:text-[#263b2a]"
                        >
                            View accommodation
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </Page>
</Layout>
