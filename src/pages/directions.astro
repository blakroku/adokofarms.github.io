---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";

const title = "Direction to Adoko Farms";
---

<Layout title={title}>
    <Page>
        <main class="directions-page">
            <!-- Hero -->
            <section class="directions-hero">
                <div class="directions-container">
                    <div class="directions-hero-content">
                        <p class="directions-eyebrow">Getting here</p>

                        <h1>
                            Find your way
                            <br />
                            to Adoko Farms.
                        </h1>

                        <p>
                            Leave the city behind and make your way into the
                            hills and countryside of Akropong-Akuapem.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Location -->
            <section class="location-section">
                <div class="directions-container">
                    <div class="location-grid">
                        <div class="location-image">
                            <img
                                src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1400&q=85"
                                alt="Ghana countryside landscape"
                            />
                        </div>

                        <div class="location-content">
                            <p class="section-label">Our location</p>

                            <h2>Out of the city. Into nature.</h2>

                            <p>
                                Adoko Farms is located in Akropong-Akuapem, in
                                Ghana's Eastern Region. The journey takes you
                                away from the pace of the city and into a
                                quieter rural landscape.
                            </p>

                            <div class="location-details">
                                <div>
                                    <span>Location</span>
                                    <strong>Akropong-Akuapem, Ghana</strong>
                                </div>

                                <div>
                                    <span>From Accra</span>
                                    <strong>Approximately 54 km</strong>
                                </div>
                            </div>

                            <a
                                href="https://www.google.com/maps"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="directions-button"
                            >
                                Open in Google Maps
                                <span>↗</span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Travel Routes -->
            <section class="routes-section">
                <div class="directions-container">
                    <div class="routes-heading">
                        <p class="section-label">Plan your journey</p>

                        <h2>
                            Getting here from
                            <br />
                            Accra.
                        </h2>

                        <p>
                            Whether you're driving up for the day or coming for
                            a longer stay, allow yourself enough time to enjoy
                            the journey.
                        </p>
                    </div>

                    <div class="routes-grid">
                        <article class="route-card">
                            <span class="route-number">01</span>

                            <h3>From Accra</h3>

                            <p>
                                Travel north-east from Accra towards the Eastern
                                Region and continue towards Akropong-Akuapem.
                            </p>

                            <div class="route-meta">
                                <span>Starting point</span>
                                <strong>Accra</strong>
                            </div>
                        </article>

                        <article class="route-card route-card-dark">
                            <span class="route-number">02</span>

                            <h3>Approaching Akropong</h3>

                            <p>
                                As you approach Akropong-Akuapem, follow the
                                local route towards the farm and use your
                                navigation app for the final part of the
                                journey.
                            </p>

                            <div class="route-meta">
                                <span>Destination</span>
                                <strong>Akropong-Akuapem</strong>
                            </div>
                        </article>

                        <article class="route-card">
                            <span class="route-number">03</span>

                            <h3>Final journey</h3>

                            <p>
                                The final stretch takes you away from the main
                                roads and into the quieter countryside
                                surrounding the farm.
                            </p>

                            <div class="route-meta">
                                <span>Arrival</span>
                                <strong>Adoko Farms</strong>
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            <!-- Map -->
            <section class="map-section">
                <div class="directions-container">
                    <div class="map-card">
                        <div class="map-placeholder">
                            <div class="map-content">
                                <span class="map-pin">●</span>

                                <p>Adoko Farms</p>

                                <span>Akropong-Akuapem, Ghana</span>

                                <a
                                    href="https://www.google.com/maps"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Get directions →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Before You Leave -->
            <section class="before-section">
                <div class="directions-container">
                    <div class="before-grid">
                        <div>
                            <span class="section-number">01</span>

                            <h2>
                                Before you
                                <br />
                                leave.
                            </h2>
                        </div>

                        <div class="before-content">
                            <div class="before-item">
                                <span>01</span>

                                <div>
                                    <h3>Check your route</h3>

                                    <p>
                                        Check your preferred navigation app
                                        before leaving and make sure you have
                                        the correct destination loaded.
                                    </p>
                                </div>
                            </div>

                            <div class="before-item">
                                <span>02</span>

                                <div>
                                    <h3>Allow enough time</h3>

                                    <p>
                                        Give yourself enough time for the
                                        journey, especially when travelling for
                                        a scheduled experience or tour.
                                    </p>
                                </div>
                            </div>

                            <div class="before-item">
                                <span>03</span>

                                <div>
                                    <h3>Keep our contact handy</h3>

                                    <p>
                                        If you have trouble finding the farm or
                                        need help during your journey, contact
                                        us and we'll help you find your way.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- CTA -->
            <section class="directions-cta">
                <div class="directions-container">
                    <div class="directions-cta-content">
                        <p>Ready to come?</p>

                        <h2>
                            We'll see you
                            <br />
                            at the farm.
                        </h2>

                        <a href="/contact">
                            Contact us
                            <span>→</span>
                        </a>
                    </div>
                </div>
            </section>
        </main>

        <style>
            .directions-page {
                background: #f4f1e8;
                color: #263b2a;
            }

            .directions-container {
                width: min(1200px, calc(100% - 48px));
                margin: 0 auto;
            }

            /* Hero */

            .directions-hero {
                padding: 150px 0 120px;
            }

            .directions-hero-content {
                max-width: 850px;
            }

            .directions-eyebrow,
            .section-label {
                margin: 0;
                color: #66705f;
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .directions-hero h1 {
                margin: 24px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(52px, 8vw, 96px);
                font-weight: 300;
                line-height: 0.95;
                letter-spacing: -0.05em;
            }

            .directions-hero-content > p:last-child {
                max-width: 620px;
                margin: 35px 0 0;
                color: #66705f;
                font-size: 18px;
                line-height: 1.7;
            }

            /* Location */

            .location-section {
                padding: 110px 0;
                background: white;
            }

            .location-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                min-height: 620px;
            }

            .location-image {
                overflow: hidden;
            }

            .location-image img {
                width: 100%;
                height: 100%;
                display: block;
                object-fit: cover;
            }

            .location-content {
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 70px;
            }

            .location-content h2 {
                max-width: 600px;
                margin: 20px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(42px, 5vw, 64px);
                font-weight: 300;
                line-height: 1;
                letter-spacing: -0.04em;
            }

            .location-content > p {
                max-width: 560px;
                margin: 30px 0 0;
                color: #66705f;
                font-size: 16px;
                line-height: 1.8;
            }

            .location-details {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 25px;
                margin-top: 40px;
                padding-top: 25px;
                border-top: 1px solid rgba(38, 59, 42, 0.12);
            }

            .location-details div {
                display: flex;
                flex-direction: column;
                gap: 7px;
            }

            .location-details span {
                color: #66705f;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.1em;
            }

            .location-details strong {
                font-size: 14px;
                font-weight: 500;
            }

            .directions-button {
                display: inline-flex;
                align-items: center;
                gap: 15px;
                align-self: flex-start;
                margin-top: 40px;
                padding: 14px 21px;
                border-radius: 999px;
                background: #263b2a;
                color: white;
                font-size: 14px;
                font-weight: 500;
                text-decoration: none;
            }

            .directions-button span {
                font-size: 17px;
            }

            /* Routes */

            .routes-section {
                padding: 120px 0;
            }

            .routes-heading {
                max-width: 720px;
            }

            .routes-heading h2 {
                margin: 18px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(42px, 6vw, 70px);
                font-weight: 300;
                line-height: 1;
                letter-spacing: -0.045em;
            }

            .routes-heading > p:last-child {
                max-width: 600px;
                margin: 30px 0 0;
                color: #66705f;
                font-size: 17px;
                line-height: 1.7;
            }

            .routes-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 20px;
                margin-top: 65px;
            }

            .route-card {
                min-height: 390px;
                padding: 35px;
                display: flex;
                flex-direction: column;
                background: white;
            }

            .route-card-dark {
                background: #66705f;
                color: white;
            }

            .route-number {
                color: #66705f;
                font-size: 13px;
            }

            .route-card-dark .route-number {
                color: rgba(255, 255, 255, 0.5);
            }

            .route-card h3 {
                margin: 65px 0 0;
                font-family: Georgia, serif;
                font-size: 30px;
                font-weight: 300;
                letter-spacing: -0.02em;
            }

            .route-card > p {
                margin: 20px 0 0;
                color: #66705f;
                font-size: 15px;
                line-height: 1.7;
            }

            .route-card-dark > p {
                color: rgba(255, 255, 255, 0.65);
            }

            .route-meta {
                display: flex;
                flex-direction: column;
                gap: 5px;
                margin-top: auto;
                padding-top: 35px;
            }

            .route-meta span {
                color: #66705f;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.1em;
            }

            .route-card-dark .route-meta span {
                color: rgba(255, 255, 255, 0.45);
            }

            .route-meta strong {
                font-size: 14px;
                font-weight: 500;
            }

            /* Map */

            .map-section {
                padding: 0 0 120px;
            }

            .map-card {
                overflow: hidden;
                border-radius: 2px;
            }

            .map-placeholder {
                min-height: 520px;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                background: linear-gradient(
                    135deg,
                    #d8d5c9 0%,
                    #ebe8dd 45%,
                    #d0d4c5 100%
                );
            }

            .map-placeholder::before,
            .map-placeholder::after {
                content: "";
                position: absolute;
                width: 150%;
                height: 1px;
                background: rgba(38, 59, 42, 0.12);
                transform: rotate(-12deg);
            }

            .map-placeholder::after {
                transform: rotate(35deg);
            }

            .map-content {
                position: relative;
                z-index: 2;
                width: min(340px, calc(100% - 40px));
                padding: 35px;
                background: white;
                text-align: center;
                box-shadow: 0 15px 50px rgba(38, 59, 42, 0.08);
            }

            .map-pin {
                display: block;
                color: #263b2a;
                font-size: 28px;
            }

            .map-content p {
                margin: 18px 0 5px;
                font-family: Georgia, serif;
                font-size: 27px;
                font-weight: 300;
            }

            .map-content > span:not(.map-pin) {
                color: #66705f;
                font-size: 13px;
            }

            .map-content a {
                display: inline-block;
                margin-top: 25px;
                color: #263b2a;
                font-size: 13px;
                font-weight: 500;
                text-decoration: none;
            }

            /* Before */

            .before-section {
                padding: 120px 0;
                background: white;
            }

            .before-grid {
                display: grid;
                grid-template-columns: 1fr 1.2fr;
                gap: 100px;
            }

            .section-number {
                color: #66705f;
                font-size: 13px;
            }

            .before-grid h2 {
                margin: 18px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(44px, 6vw, 70px);
                font-weight: 300;
                line-height: 0.98;
                letter-spacing: -0.045em;
            }

            .before-content {
                border-top: 1px solid rgba(38, 59, 42, 0.12);
            }

            .before-item {
                display: grid;
                grid-template-columns: 45px 1fr;
                gap: 20px;
                padding: 30px 0;
                border-bottom: 1px solid rgba(38, 59, 42, 0.12);
            }

            .before-item > span {
                color: #66705f;
                font-size: 13px;
            }

            .before-item h3 {
                margin: 0;
                font-size: 17px;
                font-weight: 500;
            }

            .before-item p {
                max-width: 580px;
                margin: 10px 0 0;
                color: #66705f;
                font-size: 15px;
                line-height: 1.7;
            }

            /* CTA */

            .directions-cta {
                padding: 120px 0;
                background: #263b2a;
                color: white;
            }

            .directions-cta-content {
                max-width: 850px;
            }

            .directions-cta-content > p {
                margin: 0;
                color: rgba(255, 255, 255, 0.5);
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .directions-cta h2 {
                margin: 22px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(52px, 7vw, 90px);
                font-weight: 300;
                line-height: 0.95;
                letter-spacing: -0.05em;
            }

            .directions-cta a {
                display: inline-flex;
                align-items: center;
                gap: 15px;
                margin-top: 42px;
                padding: 14px 22px;
                border-radius: 999px;
                background: white;
                color: #263b2a;
                font-size: 14px;
                font-weight: 500;
                text-decoration: none;
            }

            .directions-cta a span {
                font-size: 18px;
            }

            /* Responsive */

            @media (max-width: 900px) {
                .location-grid {
                    grid-template-columns: 1fr;
                }

                .location-image {
                    min-height: 450px;
                }

                .location-content {
                    padding: 55px 40px;
                }

                .routes-grid {
                    grid-template-columns: 1fr;
                }

                .route-card {
                    min-height: 330px;
                }

                .before-grid {
                    grid-template-columns: 1fr;
                    gap: 60px;
                }
            }

            @media (max-width: 640px) {
                .directions-container {
                    width: calc(100% - 32px);
                }

                .directions-hero {
                    padding: 110px 0 80px;
                }

                .location-section,
                .routes-section,
                .before-section {
                    padding: 80px 0;
                }

                .location-image {
                    min-height: 330px;
                }

                .location-content {
                    padding: 45px 25px;
                }

                .location-details {
                    grid-template-columns: 1fr;
                }

                .routes-grid {
                    margin-top: 45px;
                }

                .route-card {
                    min-height: 310px;
                    padding: 30px;
                }

                .map-section {
                    padding-bottom: 80px;
                }

                .map-placeholder {
                    min-height: 420px;
                }

                .before-item {
                    grid-template-columns: 35px 1fr;
                }

                .directions-cta {
                    padding: 90px 0;
                }
            }
        </style>
    </Page>
</Layout>
