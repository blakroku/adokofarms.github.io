---
import Layout from "../layouts/Layout.astro";
import Page from "../components/Page.astro";
import Hero from "../components/Hero.astro";
import Direction from "../components/Direction.astro";
---

<Layout title="Directions to Adoko Farms Eco Resort">
    <Page>
        <Hero
            heroTitle="Getting here"
            firstHeroTitle="Find your way"
            secondHeroTitle="to Adoko Farms"
        />
        <main class="directions-page">
            <Direction />

            <!-- Location -->
        </main>

        <style>
            .directions-page {
                /*background: #eae8e5;*/
                color: #263b2a;
            }

            .directions-container {
                width: min(1200px, calc(100% - 48px));
                margin: 0 auto;
            }

            /* Hero */

            .directions-hero {
                padding: 150px 0 120px;
            }

            .directions-hero-content {
                max-width: 850px;
            }

            .directions-eyebrow,
            .section-label {
                margin: 0;
                color: #66705f;
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .directions-hero h1 {
                margin: 24px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(52px, 8vw, 96px);
                font-weight: 300;
                line-height: 0.95;
                letter-spacing: -0.05em;
            }

            .directions-hero-content > p:last-child {
                max-width: 620px;
                margin: 35px 0 0;
                color: #66705f;
                font-size: 18px;
                line-height: 1.7;
            }

            /* Location */

            .location-section {
                padding: 110px 0;
                /*background: #eae8e5;*/
            }

            .location-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                min-height: 620px;
            }

            .location-image {
                overflow: hidden;
            }

            .location-image img {
                width: 100%;
                height: 100%;
                display: block;
                object-fit: cover;
            }

            .location-content {
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 70px;
            }

            .location-content h2 {
                max-width: 600px;
                margin: 20px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(42px, 5vw, 64px);
                font-weight: 300;
                line-height: 1;
                letter-spacing: -0.04em;
            }

            .location-content > p {
                max-width: 560px;
                margin: 30px 0 0;
                color: #66705f;
                font-size: 16px;
                line-height: 1.8;
            }

            .location-details {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 25px;
                margin-top: 40px;
                padding-top: 25px;
                border-top: 1px solid rgba(38, 59, 42, 0.12);
            }

            .location-details div {
                display: flex;
                flex-direction: column;
                gap: 7px;
            }

            .location-details span {
                color: #66705f;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.1em;
            }

            .location-details strong {
                font-size: 14px;
                font-weight: 500;
            }

            .directions-button {
                display: inline-flex;
                align-items: center;
                gap: 15px;
                align-self: flex-start;
                margin-top: 40px;
                padding: 14px 21px;
                border-radius: 999px;
                background: #263b2a;
                color: white;
                font-size: 14px;
                font-weight: 500;
                text-decoration: none;
            }

            .directions-button span {
                font-size: 17px;
            }

            /* Routes */

            .routes-section {
                padding: 120px 0;
            }

            .routes-heading {
                max-width: 720px;
            }

            .routes-heading h2 {
                margin: 18px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(42px, 6vw, 70px);
                font-weight: 300;
                line-height: 1;
                letter-spacing: -0.045em;
            }

            .routes-heading > p:last-child {
                max-width: 600px;
                margin: 30px 0 0;
                color: #66705f;
                font-size: 17px;
                line-height: 1.7;
            }

            .routes-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 20px;
                margin-top: 65px;
            }

            .route-card {
                min-height: 390px;
                padding: 35px;
                display: flex;
                flex-direction: column;
                background: white;
            }

            .route-card-dark {
                background: #66705f;
                color: white;
            }

            .route-number {
                color: #66705f;
                font-size: 13px;
            }

            .route-card-dark .route-number {
                color: rgba(255, 255, 255, 0.5);
            }

            .route-card h3 {
                margin: 65px 0 0;
                font-family: Georgia, serif;
                font-size: 30px;
                font-weight: 300;
                letter-spacing: -0.02em;
            }

            .route-card > p {
                margin: 20px 0 0;
                color: #66705f;
                font-size: 15px;
                line-height: 1.7;
            }

            .route-card-dark > p {
                color: rgba(255, 255, 255, 0.65);
            }

            .route-meta {
                display: flex;
                flex-direction: column;
                gap: 5px;
                margin-top: auto;
                padding-top: 35px;
            }

            .route-meta span {
                color: #66705f;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.1em;
            }

            .route-card-dark .route-meta span {
                color: rgba(255, 255, 255, 0.45);
            }

            .route-meta strong {
                font-size: 14px;
                font-weight: 500;
            }

            /* Map */

            .map-section {
                padding: 0 0 120px;
            }

            .map-card {
                overflow: hidden;
                border-radius: 2px;
            }

            .map-placeholder {
                min-height: 520px;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                background: linear-gradient(
                    135deg,
                    #d8d5c9 0%,
                    #ebe8dd 45%,
                    #d0d4c5 100%
                );
            }

            .map-placeholder::before,
            .map-placeholder::after {
                content: "";
                position: absolute;
                width: 150%;
                height: 1px;
                background: rgba(38, 59, 42, 0.12);
                transform: rotate(-12deg);
            }

            .map-placeholder::after {
                transform: rotate(35deg);
            }

            .map-content {
                position: relative;
                z-index: 2;
                width: min(340px, calc(100% - 40px));
                padding: 35px;
                background: white;
                text-align: center;
                box-shadow: 0 15px 50px rgba(38, 59, 42, 0.08);
            }

            .map-pin {
                display: block;
                color: #263b2a;
                font-size: 28px;
            }

            .map-content p {
                margin: 18px 0 5px;
                font-family: Georgia, serif;
                font-size: 27px;
                font-weight: 300;
            }

            .map-content > span:not(.map-pin) {
                color: #66705f;
                font-size: 13px;
            }

            .map-content a {
                display: inline-block;
                margin-top: 25px;
                color: #263b2a;
                font-size: 13px;
                font-weight: 500;
                text-decoration: none;
            }

            /* Before */

            .before-section {
                padding: 120px 0;
                background: white;
            }

            .before-grid {
                display: grid;
                grid-template-columns: 1fr 1.2fr;
                gap: 100px;
            }

            .section-number {
                color: #66705f;
                font-size: 13px;
            }

            .before-grid h2 {
                margin: 18px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(44px, 6vw, 70px);
                font-weight: 300;
                line-height: 0.98;
                letter-spacing: -0.045em;
            }

            .before-content {
                border-top: 1px solid rgba(38, 59, 42, 0.12);
            }

            .before-item {
                display: grid;
                grid-template-columns: 45px 1fr;
                gap: 20px;
                padding: 30px 0;
                border-bottom: 1px solid rgba(38, 59, 42, 0.12);
            }

            .before-item > span {
                color: #66705f;
                font-size: 13px;
            }

            .before-item h3 {
                margin: 0;
                font-size: 17px;
                font-weight: 500;
            }

            .before-item p {
                max-width: 580px;
                margin: 10px 0 0;
                color: #66705f;
                font-size: 15px;
                line-height: 1.7;
            }

            /* CTA */

            .directions-cta {
                padding: 120px 0;
                background: #263b2a;
                color: white;
            }

            .directions-cta-content {
                max-width: 850px;
            }

            .directions-cta-content > p {
                margin: 0;
                color: rgba(255, 255, 255, 0.5);
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .directions-cta h2 {
                margin: 22px 0 0;
                font-family: Georgia, serif;
                font-size: clamp(52px, 7vw, 90px);
                font-weight: 300;
                line-height: 0.95;
                letter-spacing: -0.05em;
            }

            .directions-cta a {
                display: inline-flex;
                align-items: center;
                gap: 15px;
                margin-top: 42px;
                padding: 14px 22px;
                border-radius: 999px;
                background: white;
                color: #263b2a;
                font-size: 14px;
                font-weight: 500;
                text-decoration: none;
            }

            .directions-cta a span {
                font-size: 18px;
            }

            /* Responsive */

            @media (max-width: 900px) {
                .location-grid {
                    grid-template-columns: 1fr;
                }

                .location-image {
                    min-height: 450px;
                }

                .location-content {
                    padding: 55px 40px;
                }

                .routes-grid {
                    grid-template-columns: 1fr;
                }

                .route-card {
                    min-height: 330px;
                }

                .before-grid {
                    grid-template-columns: 1fr;
                    gap: 60px;
                }
            }

            @media (max-width: 640px) {
                .directions-container {
                    width: calc(100% - 32px);
                }

                .directions-hero {
                    padding: 110px 0 80px;
                }

                .location-section,
                .routes-section,
                .before-section {
                    padding: 80px 0;
                }

                .location-image {
                    min-height: 330px;
                }

                .location-content {
                    padding: 45px 25px;
                }

                .location-details {
                    grid-template-columns: 1fr;
                }

                .routes-grid {
                    margin-top: 45px;
                }

                .route-card {
                    min-height: 310px;
                    padding: 30px;
                }

                .map-section {
                    padding-bottom: 80px;
                }

                .map-placeholder {
                    min-height: 420px;
                }

                .before-item {
                    grid-template-columns: 35px 1fr;
                }

                .directions-cta {
                    padding: 90px 0;
                }
            }
        </style>
    </Page>
</Layout>
